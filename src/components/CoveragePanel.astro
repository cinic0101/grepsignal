---
import coverage from '../data/coverage.json';

const base = import.meta.env.BASE_URL;
const statusLabels: Record<string, string> = {
  not_recorded: 'REVIEW HISTORY INCOMPLETE',
  partial: 'PARTIAL REVIEW',
  reviewed: 'REVIEWED',
};
const reviewed = (value: number | null, total: number) =>
  value === null ? 'Review completion not recorded' : `${value.toLocaleString('en')} / ${total.toLocaleString('en')} reviewed`;
---
<section class="coverage-section" id="coverage" aria-labelledby="coverage-heading">
  <div class="section-head">
    <div>
      <span class="section-kicker">RESEARCH COVERAGE</span>
      <h2 id="coverage-heading">Coverage</h2>
    </div>
    <span class="beta">{statusLabels[coverage.coverage_status]}</span>
  </div>

  <div class="coverage-layout">
    <div>
      <p class="coverage-intro">
        GrepSignal screens configured discovery sources, then follows promising items to original and
        primary evidence. Coverage describes this intake — not complete coverage of the AI ecosystem.
      </p>
      <div class="source-grid">
        {coverage.sources.map(source => (
          <article class="source-card">
            <span class="label">{source.name}</span>
            <strong>{source.scope}</strong>
            <span>{reviewed(source.reviewed_count, source.intake_count)}</span>
          </article>
        ))}
      </div>
    </div>

    <aside class="coverage-results" aria-label="Research output">
      <div>
        <strong>{coverage.primary_sources_consulted}</strong>
        <span>primary / affected-party<br />sources consulted</span>
      </div>
      <div>
        <strong>{coverage.published_signals}</strong>
        <span>material signal{coverage.published_signals === 1 ? '' : 's'}<br />published</span>
      </div>
    </aside>
  </div>

  <div class="coverage-bottom">
    <span>{coverage.note}</span>
    <a href={`${base}data/coverage.json`}>Coverage JSON ↗</a>
  </div>
</section>

<style>
  .coverage-section {
    margin-top: 48px;
    padding: 28px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .coverage-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 46px;
    align-items: start;
  }
  .coverage-intro {
    max-width: 760px;
    margin: 0 0 20px;
    font-size: 15px;
    color: #3d3b36;
  }
  .source-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .source-card {
    min-height: 116px;
    padding: 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .source-card strong {
    display: block;
    margin: 7px 0 8px;
    font: 600 18px/1.25 Georgia, 'Times New Roman', serif;
  }
  .source-card > span:last-child {
    display: block;
    color: var(--muted);
    font-size: 12px;
  }
  .coverage-results {
    min-width: 250px;
    display: grid;
    gap: 18px;
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }
  .coverage-results > div {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .coverage-results strong {
    min-width: 52px;
    font: 500 42px/1 Georgia, serif;
    color: var(--accent);
  }
  .coverage-results span {
    color: var(--muted);
    font-size: 11px;
  }
  .coverage-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 11px;
  }
  .coverage-bottom span { max-width: 780px; }
  .coverage-bottom a { white-space: nowrap; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .coverage-layout, .source-grid { grid-template-columns: 1fr; }
    .coverage-results { padding: 20px 0 0; border-left: 0; border-top: 1px solid var(--line); }
    .coverage-bottom { flex-wrap: wrap; }
  }
</style>

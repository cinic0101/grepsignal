---
import coverage from '../data/coverage.json';
import intelligence from '../data/intelligence';

const base = import.meta.env.BASE_URL;
const statusLabels: Record<string, string> = {
  not_recorded: 'REVIEW HISTORY INCOMPLETE',
  partial: 'PARTIAL REVIEW',
  reviewed: 'REVIEWED',
};
const reviewed = (value: number | null, total: number) =>
  value === null ? 'completion not recorded' : `${value.toLocaleString('en')} / ${total.toLocaleString('en')} reviewed`;
const lastReviewed = new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(coverage.generated_at));
const cycleDateMatch = coverage.cycle_id.match(/cycle-(\d{4}-\d{2}-\d{2})/);
const reviewDate = cycleDateMatch?.[1] ?? new Date(coverage.generated_at).toISOString().slice(0, 10);
const signalsRegistered = intelligence.signals.filter(signal => signal.registered_at === reviewDate).length;
const threadChangesRegistered = intelligence.threads.reduce(
  (count, thread) => count + thread.updates.filter(update => update.date === reviewDate).length,
  0,
);
---
<section class="coverage-section" id="coverage" aria-labelledby="coverage-heading" data-nosnippet>
  <div class="coverage-head">
    <div>
      <span class="section-kicker">REVIEW COVERAGE · {lastReviewed.toUpperCase()}</span>
      <h2 id="coverage-heading">What did we actually review?</h2>
    </div>
    <span class="beta">{statusLabels[coverage.coverage_status]}</span>
  </div>

  <div class="coverage-sources" aria-label="Scheduled source coverage">
    {coverage.sources.map(source => (
      <article>
        <span>{source.name}</span>
        <strong>{reviewed(source.reviewed_count, source.intake_count)}</strong>
        <small>{source.scope}</small>
      </article>
    ))}
  </div>

  <div class="coverage-metrics" aria-label="Review and publication outcomes">
    <div><strong>{coverage.research_targets_reviewed}</strong><span>research targets reviewed</span></div>
    <div><strong>{coverage.exact_sources_materialized}</strong><span>exact sources materialized</span></div>
    <div><strong>{signalsRegistered}</strong><span>signals registered that date</span></div>
    <div><strong>{threadChangesRegistered}</strong><span>thread changes registered</span></div>
  </div>

  <div class="coverage-bottom">
    <span>Frozen scheduled intake, not complete coverage of the AI ecosystem. {coverage.note}</span>
    <a href={`${base}data/coverage.json`}>Coverage JSON ↗</a>
  </div>
</section>

<style>
  .coverage-section {
    margin-top: 52px;
    padding: 26px 0 4px;
    border-top: 1px solid var(--ink);
  }
  .coverage-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    margin-bottom: 18px;
  }
  .coverage-head h2 {
    margin: 4px 0 0;
    font: 600 30px/1.08 Georgia, 'Times New Roman', serif;
    letter-spacing: -.025em;
  }
  .coverage-sources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .coverage-sources article {
    min-width: 0;
    padding: 16px 18px 16px 0;
  }
  .coverage-sources article + article {
    padding-left: 18px;
    border-left: 1px solid var(--line);
  }
  .coverage-sources span {
    display: block;
    color: var(--accent);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .coverage-sources strong {
    display: block;
    margin-top: 6px;
    font-size: 14px;
  }
  .coverage-sources small {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.45;
  }
  .coverage-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .coverage-metrics div { display: flex; align-items: center; gap: 11px; }
  .coverage-metrics strong {
    flex: 0 0 auto;
    font: 500 30px/1 Georgia, serif;
    color: var(--accent);
  }
  .coverage-metrics span { color: var(--muted); font-size: 11px; line-height: 1.35; }
  .coverage-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 14px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .coverage-bottom span { max-width: 830px; }
  .coverage-bottom a { white-space: nowrap; text-underline-offset: 3px; }

  @media (max-width: 760px) {
    .coverage-head { align-items: flex-start; flex-direction: column; gap: 10px; }
    .coverage-sources { grid-template-columns: 1fr 1fr; }
    .coverage-sources article + article { border-left: 0; }
    .coverage-sources article:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line); }
    .coverage-metrics { grid-template-columns: 1fr 1fr; }
    .coverage-bottom { flex-wrap: wrap; }
  }
  @media (max-width: 520px) {
    .coverage-sources { grid-template-columns: 1fr; }
    .coverage-sources article,
    .coverage-sources article:nth-child(even) { padding-left: 0; border-left: 0; }
    .coverage-sources article + article { border-top: 1px solid var(--line); }
    .coverage-metrics { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

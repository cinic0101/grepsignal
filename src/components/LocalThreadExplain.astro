---
interface ThreadLike {
  title: string;
  summary: string;
  thesis?: string;
  updates: Array<{
    date: string;
    assessment: string;
    change: string;
  }>;
  analysis?: {
    boundaries: string[];
    evidence_map: Array<{
      title: string;
      summary: string;
    }>;
  };
}
interface Props {
  thread: ThreadLike;
}

const { thread } = Astro.props;
const latest = [...thread.updates].sort((a, b) => b.date.localeCompare(a.date))[0];
const payload = JSON.stringify({
  title: thread.title,
  summary: thread.summary,
  thesis: thread.thesis ?? thread.summary,
  latest_change: latest?.change ?? thread.summary,
  latest_assessment: latest?.assessment ?? 'stable',
  boundaries: thread.analysis?.boundaries ?? [],
  evidence_map: (thread.analysis?.evidence_map ?? []).map(({ title, summary }) => ({ title, summary })),
}).replace(/</g, '\\u003c');
---
<section class="local-thread-explain" data-local-thread-explain>
  <div class="explain-head">
    <div>
      <span class="section-kicker">LOCAL AI · EXPERIMENTAL</span>
      <h2>Explore this Thread locally</h2>
      <p>A small model explains only the approved Thread data on your device. It cannot add evidence, change the thesis, or publish a new Signal.</p>
    </div>
    <div class="actions">
      <button type="button" class="secondary" data-local-ai-enable>Enable Local AI</button>
      <button type="button" class="primary" data-local-thread-run hidden>Explain this Thread</button>
    </div>
  </div>

  <div class="privacy-note">WebGPU required · one-time model download · inference stays in your browser · canonical Thread data remains authoritative</div>

  <div class="local-progress" data-local-thread-progress hidden aria-live="polite">
    <span class="section-kicker">READING LOCALLY</span>
    <ol>
      <li data-local-thread-step="read"><span aria-hidden="true">·</span>Reading the approved Thread</li>
      <li data-local-thread-step="thesis"><span aria-hidden="true">·</span>Explaining the current thesis</li>
      <li data-local-thread-step="change"><span aria-hidden="true">·</span>Explaining the latest change</li>
    </ol>
  </div>

  <div class="explain-output" data-local-thread-output hidden aria-live="polite">
    <div class="generated-grid">
      <article data-local-thread-thesis-card hidden>
        <span>Thread in plain English</span>
        <p data-local-thread-thesis></p>
      </article>
      <article data-local-thread-change-card hidden>
        <span>What changed recently?</span>
        <p data-local-thread-change></p>
      </article>
    </div>

    {thread.analysis && thread.analysis.boundaries.length > 0 && (
      <div class="keep-in-mind">
        <span class="section-kicker">KEEP IN MIND · FROM THE PUBLISHED THREAD</span>
        <ul>{thread.analysis.boundaries.map((item) => <li>{item}</li>)}</ul>
      </div>
    )}

    <details class="explain-method" data-local-thread-method hidden>
      <summary>How this explanation was built</summary>
      <ul>
        <li>Generated locally with <code data-local-thread-model-id>the selected browser model</code>.</li>
        <li>The model receives only the approved Thread thesis, latest revision, evidence-map descriptions, and published boundaries.</li>
        <li>It is instructed not to add external facts, evidence, recommendations, forecasts, or new Signals.</li>
        <li>Published boundaries above are inserted directly, not generated by the model.</li>
      </ul>
    </details>

    <p class="generated-note">This explanation is locally generated and may be imperfect. The published Thread, Signals, and linked evidence remain authoritative.</p>
  </div>

  <details class="developer-trace" data-local-thread-debug hidden>
    <summary>Developer trace</summary>
    <p>Visible only with <code>?debug=local-ai</code>. Raw local-model output is not GrepSignal analysis.</p>
    <pre data-local-thread-debug-raw></pre>
  </details>

  <p class="explain-error" data-local-thread-error hidden></p>
  <script is:inline type="application/json" data-local-thread-payload set:html={payload}></script>
</section>

<script>
  type ExplainTask = 'thread_explain' | 'thread_latest_change';
  type LocalAIState = {
    enabled: boolean;
    phase: string;
    modelId?: string | null;
  };
  type StreamUpdate = {
    task: ExplainTask;
    raw: string;
    visible: string;
    thinking: boolean;
    done: boolean;
  };
  type Manager = {
    getState: () => LocalAIState;
    generate: (
      task: ExplainTask,
      payload: unknown,
      onUpdate?: (update: StreamUpdate) => void,
    ) => Promise<string>;
  };
  type StepName = 'read' | 'thesis' | 'change';

  const getManager = async (): Promise<Manager> => {
    const current = (window as any).__grepsignalLocalAI as Manager | undefined;
    if (current) return current;
    return await new Promise((resolve) => {
      window.addEventListener('grepsignal:local-ai-manager-ready', () => {
        resolve((window as any).__grepsignalLocalAI as Manager);
      }, { once: true });
    });
  };

  const cleanGeneratedText = (value: string) => value
    .trim()
    .replace(/^['“"]+/, '')
    .replace(/['”"]+$/, '')
    .trim();

  document.querySelectorAll<HTMLElement>('[data-local-thread-explain]').forEach((root) => {
    const run = root.querySelector<HTMLButtonElement>('[data-local-thread-run]');
    const output = root.querySelector<HTMLElement>('[data-local-thread-output]');
    const progress = root.querySelector<HTMLElement>('[data-local-thread-progress]');
    const error = root.querySelector<HTMLElement>('[data-local-thread-error]');
    const payloadNode = root.querySelector<HTMLScriptElement>('[data-local-thread-payload]');
    const thesis = root.querySelector<HTMLElement>('[data-local-thread-thesis]');
    const change = root.querySelector<HTMLElement>('[data-local-thread-change]');
    const thesisCard = root.querySelector<HTMLElement>('[data-local-thread-thesis-card]');
    const changeCard = root.querySelector<HTMLElement>('[data-local-thread-change-card]');
    const method = root.querySelector<HTMLDetailsElement>('[data-local-thread-method]');
    const modelId = root.querySelector<HTMLElement>('[data-local-thread-model-id]');
    const debug = root.querySelector<HTMLDetailsElement>('[data-local-thread-debug]');
    const debugRaw = root.querySelector<HTMLElement>('[data-local-thread-debug-raw]');
    if (!run || !output || !progress || !error || !payloadNode || !thesis || !change || !thesisCard || !changeCard || !method || !modelId || !debug || !debugRaw) return;

    const debugEnabled = new URLSearchParams(window.location.search).get('debug') === 'local-ai';
    debug.hidden = !debugEnabled;

    const step = (name: StepName) => root.querySelector<HTMLElement>(`[data-local-thread-step="${name}"]`);
    const resetSteps = () => {
      (['read', 'thesis', 'change'] as StepName[]).forEach((name) => {
        const node = step(name);
        node?.classList.remove('is-active', 'is-done', 'is-failed');
        const marker = node?.querySelector('span');
        if (marker) marker.textContent = '·';
      });
    };
    const setStep = (name: StepName, state: 'active' | 'done' | 'failed') => {
      const node = step(name);
      if (!node) return;
      node.classList.remove('is-active', 'is-done', 'is-failed');
      node.classList.add(`is-${state}`);
      const marker = node.querySelector('span');
      if (marker) marker.textContent = state === 'done' ? '✓' : state === 'failed' ? '×' : '→';
    };

    const renderState = (state: { phase: string }) => {
      run.hidden = state.phase !== 'ready' && state.phase !== 'running';
      run.disabled = state.phase !== 'ready';
    };

    getManager().then((manager) => renderState(manager.getState()));
    window.addEventListener('grepsignal:local-ai-state', (event) => {
      renderState((event as CustomEvent).detail);
    });

    run.addEventListener('click', async () => {
      run.disabled = true;
      run.textContent = 'Explaining locally…';
      error.hidden = true;
      output.hidden = true;
      method.hidden = true;
      thesisCard.hidden = true;
      changeCard.hidden = true;
      thesis.textContent = '';
      change.textContent = '';
      debugRaw.textContent = '';
      progress.hidden = false;
      resetSteps();
      setStep('read', 'done');

      const traces: Partial<Record<ExplainTask, { raw: string; visible: string }>> = {};
      const refreshDebug = () => {
        if (debugEnabled) debugRaw.textContent = JSON.stringify(traces, null, 2);
      };

      let activeStep: StepName = 'thesis';
      try {
        const manager = await getManager();
        const parsed = JSON.parse(payloadNode.textContent || '{}');

        setStep('thesis', 'active');
        const thesisText = cleanGeneratedText(await manager.generate('thread_explain', parsed, (update) => {
          traces.thread_explain = { raw: update.raw, visible: update.visible };
          refreshDebug();
          const visible = cleanGeneratedText(update.visible);
          if (visible) {
            thesis.textContent = visible;
            thesisCard.hidden = false;
            output.hidden = false;
          }
        }));
        if (!thesisText) throw new Error('Local AI could not produce a reliable Thread explanation.');
        thesis.textContent = thesisText;
        thesisCard.hidden = false;
        output.hidden = false;
        setStep('thesis', 'done');

        activeStep = 'change';
        setStep('change', 'active');
        const changeText = cleanGeneratedText(await manager.generate('thread_latest_change', parsed, (update) => {
          traces.thread_latest_change = { raw: update.raw, visible: update.visible };
          refreshDebug();
          const visible = cleanGeneratedText(update.visible);
          if (visible) {
            change.textContent = visible;
            changeCard.hidden = false;
          }
        }));
        if (!changeText) throw new Error('Local AI could not explain the latest Thread change.');
        change.textContent = changeText;
        changeCard.hidden = false;
        setStep('change', 'done');

        modelId.textContent = manager.getState().modelId ?? 'the selected browser model';
        method.hidden = false;
      } catch (cause) {
        console.error('[GrepSignal Local AI] Thread explanation failed', cause);
        setStep(activeStep, 'failed');
        output.hidden = true;
        error.textContent = cause instanceof Error
          ? `${cause.message} Please use the published Thread.`
          : 'Local Thread explanation failed. Please use the published Thread.';
        error.hidden = false;
      } finally {
        run.textContent = 'Explain this Thread';
        const manager = (window as any).__grepsignalLocalAI as Manager | undefined;
        run.disabled = manager?.getState().phase !== 'ready';
      }
    });
  });
</script>

<style>
  .local-thread-explain { margin: 0 0 42px; padding: 24px; border: 1px solid var(--ink); border-radius: var(--radius); background: #f4f1e9; }
  .explain-head { display: flex; justify-content: space-between; gap: 28px; align-items: flex-start; }
  .explain-head h2 { margin: 5px 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: 29px; line-height: 1.12; }
  .explain-head p { max-width: 680px; margin: 0; color: #3c3a35; line-height: 1.55; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  button { border-radius: 999px; padding: 10px 14px; font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; white-space: nowrap; }
  button.primary { border: 1px solid var(--accent); background: var(--accent); color: white; }
  button.secondary { border: 1px solid var(--ink); background: transparent; color: var(--ink); }
  button:disabled { cursor: default; opacity: .62; }
  button[hidden] { display: none; }
  .privacy-note { margin-top: 16px; padding-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font: 650 10px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .03em; }
  .local-progress { margin-top: 20px; padding: 17px 18px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,.44); }
  .local-progress ol { display: grid; gap: 7px; margin: 11px 0 0; padding: 0; list-style: none; }
  .local-progress li { display: flex; gap: 9px; align-items: baseline; color: var(--muted); font-size: 13px; }
  .local-progress li span { width: 14px; flex: 0 0 14px; font: 800 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .local-progress li.is-active { color: var(--accent); font-weight: 720; }
  .local-progress li.is-done { color: #34332f; }
  .local-progress li.is-failed { color: #8b2b24; }
  .explain-output { margin-top: 24px; }
  .generated-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .generated-grid article { border: 1px solid var(--line); background: rgba(255,255,255,.55); border-radius: 8px; padding: 16px; }
  .generated-grid span { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .05em; }
  .generated-grid p { margin: 8px 0 0; color: #34332f; line-height: 1.55; white-space: pre-wrap; }
  .generated-grid article[hidden] { display: none; }
  .keep-in-mind { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
  .keep-in-mind ul { margin: 10px 0 0; padding-left: 20px; color: #3d3b36; font-size: 14px; }
  .keep-in-mind li + li { margin-top: 8px; }
  .explain-method, .developer-trace { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px; }
  .explain-method summary, .developer-trace summary { cursor: pointer; color: var(--accent); font: 780 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .04em; }
  .explain-method ul { margin: 12px 0 0; padding-left: 20px; color: #3d3b36; font-size: 13px; line-height: 1.55; }
  .developer-trace p { margin: 10px 0; color: var(--muted); font-size: 12px; }
  .developer-trace pre { max-height: 320px; overflow: auto; margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 6px; background: #191815; color: #e8e3d8; white-space: pre-wrap; word-break: break-word; font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .generated-note, .explain-error { margin: 16px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .explain-error { color: #8b2b24; }
  @media (max-width: 760px) {
    .explain-head { flex-direction: column; }
    .actions { justify-content: flex-start; }
    .generated-grid { grid-template-columns: 1fr; }
  }
</style>

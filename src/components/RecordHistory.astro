---
import intelligence, { changes } from '../data/intelligence';

const base = import.meta.env.BASE_URL;
const id = Astro.url.pathname.split('/').filter(Boolean).at(-1);
const record = [...intelligence.signals, ...intelligence.threads, ...intelligence.predictions].find((item) => item.id === id);
const events = record ? changes.filter((event) => event.record_id === record.id) : [];
const targetUrl = (target) => `${base}${intelligence.threads.some(r => r.id === target) ? 'threads' : intelligence.predictions.some(r => r.id === target) ? 'predictions' : 'signals'}/${target}/`;
const formatTimestamp = (value) => new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' }).format(new Date(value));
const formatDateOnly = (value) => new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));

const facts = [];
if (record) {
  if ('registered_at' in record && record.registered_at) facts.push(['Registered', record.registered_at, 'date']);
  if ('created_at' in record && record.created_at) facts.push(['Created', record.created_at, record.created_at.includes('T') ? 'timestamp' : 'date']);
  if (record.first_observed_at) facts.push(['First observed', record.first_observed_at, 'timestamp']);
  if (record.first_public_at) facts.push(['Verified first public', record.first_public_at, 'timestamp']);
  if (record.last_reviewed_at) facts.push(['Last reviewed', record.last_reviewed_at, 'timestamp']);
  if (record.last_changed_at) facts.push(['Last changed', record.last_changed_at, 'timestamp']);
  if (record.next_review_at) facts.push(['Next check', record.next_review_at, 'timestamp']);
  if (record.last_review_outcome) facts.push(['Last review outcome', record.last_review_outcome, 'text']);
}
---
{record && (
  <aside class="wrap record-history" aria-label="Record revision history">
    <details>
      <summary>Record history · revision {record.version} · {events.length} post-migration event{events.length === 1 ? '' : 's'}</summary>

      {facts.length > 0 && (
        <dl class="history-facts">
          {facts.map(([label, value, kind]) => (
            <div>
              <dt>{label}</dt>
              <dd>
                {kind === 'timestamp' ? <time datetime={value} title={value}>{formatTimestamp(value)}</time> : kind === 'date' ? <time datetime={value} title={value}>{formatDateOnly(value)}</time> : value}
              </dd>
            </div>
          ))}
        </dl>
      )}

      <p class="history-note">
        Unrecorded timestamps are omitted rather than inferred. Unknown legacy dates and human-review scope were not backfilled.
        {' '}<a href={intelligence.accountability.baseline_ref}>Open the original legacy snapshot →</a>
      </p>

      {events.length === 0 ? (
        <p class="history-note">No new judgment change is recorded in the public journal. Migration is not a review.</p>
      ) : (
        <ol class="history-events">
          {events.map((event) => (
            <li>
              <a href={`${base}changes/#${event.id}`}><time datetime={event.recorded_at} title={event.recorded_at}>{formatTimestamp(event.recorded_at)}</time> · {event.kind}</a>
              <p>{event.note}</p>
            </li>
          ))}
        </ol>
      )}

      {record.relations.length > 0 && (
        <ul class="history-relations">
          {record.relations.map((relation) => (
            <li>
              {relation.relationship} <a href={targetUrl(relation.target_id)}>{relation.target_id}</a> at version {relation.target_version}: {relation.rationale}
            </li>
          ))}
        </ul>
      )}
    </details>
  </aside>
)}
<style>
  .record-history {
    padding-top: 18px;
    padding-bottom: 34px;
    font-size: 14px;
    line-height: 1.65;
  }
  details {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
  }
  .history-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
    margin: 18px 0;
  }
  .history-facts div { min-width: 0; }
  .history-facts dt {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .history-facts dd { margin: 3px 0 0; overflow-wrap: anywhere; }
  .history-note { color: var(--muted); }
  .history-note a, .history-events a, .history-relations a { color: var(--accent); }
  .history-events, .history-relations { padding-left: 22px; }
  .history-events li + li, .history-relations li + li { margin-top: 12px; }
  .history-events p { margin: 4px 0 0; }
  @media (max-width: 620px) {
    .history-facts { grid-template-columns: 1fr; }
  }
</style>

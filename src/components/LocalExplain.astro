---
interface SignalLike {
  title: string;
  summary: string;
  why_it_matters: string;
  limitations: string[];
}
interface Props {
  signal: SignalLike;
}

const { signal } = Astro.props;
const payload = JSON.stringify(signal).replace(/</g, '\\u003c');
---
<details class="local-ai-shell">
  <summary>
    <span>Local AI reading aid</span>
    <small>Optional · WebGPU · typically hundreds of MB</small>
  </summary>
<section class="local-explain" data-local-explain>
  <div class="explain-head">
    <div>
      <span class="section-kicker">LOCAL AI · EXPERIMENTAL</span>
      <h2>Explain this signal simply</h2>
      <p>A small model rewrites only this approved signal on your device. It cannot change GrepSignal's published analysis.</p>
    </div>
    <div class="actions">
      <button type="button" class="secondary" data-local-ai-enable>Enable Local AI</button>
      <button type="button" class="primary" data-local-explain-run hidden>Explain simply</button>
    </div>
  </div>

  <div class="privacy-note">WebGPU required · one-time model download (typically hundreds of MB; varies by selected model) · inference stays in your browser · original evidence and limitations remain authoritative</div>

  <div class="local-progress" data-local-progress hidden aria-live="polite">
    <span class="section-kicker">ANALYZING LOCALLY</span>
    <ol>
      <li data-local-step="read"><span aria-hidden="true">·</span>Reading the approved signal</li>
      <li data-local-step="changed"><span aria-hidden="true">·</span>Simplifying what changed</li>
      <li data-local-step="matter"><span aria-hidden="true">·</span>Explaining why it could matter</li>
    </ol>
    <p>Each section is generated independently into a fixed UI slot. Raw model reasoning is not shown in the normal reading experience.</p>
  </div>

  <div class="explain-output" data-local-explain-output hidden aria-live="polite">
    <div class="generated-grid">
      <article data-local-explain-changed-card hidden>
        <span>What changed?</span>
        <p data-local-explain-changed></p>
      </article>
      <article data-local-explain-matter-card hidden>
        <span>Why could it matter?</span>
        <p data-local-explain-matter></p>
      </article>
    </div>
    <div class="keep-in-mind">
      <span class="section-kicker">KEEP IN MIND · FROM THE PUBLISHED SIGNAL</span>
      <ul>{signal.limitations.map((item) => <li>{item}</li>)}</ul>
    </div>
    <details class="explain-method" data-local-explain-method hidden>
      <summary>How this explanation was built</summary>
      <ul>
        <li>Generated locally with <code data-local-model-id>the selected browser model</code>.</li>
        <li>What changed rewrites only the published summary into simpler language.</li>
        <li>Why it matters rewrites the published implication while preserving uncertainty, scope, and causal direction.</li>
        <li>Published limitations above are inserted directly, not generated by the model.</li>
        <li>No output labels or model-generated schema are trusted or parsed.</li>
      </ul>
    </details>
    <p class="generated-note">The explanation above is locally generated and may be imperfect. Use the published signal and linked evidence for the authoritative record.</p>
  </div>

  <details class="developer-trace" data-local-debug hidden>
    <summary>Developer trace</summary>
    <p>Visible only with <code>?debug=local-ai</code>. This is raw local-model output for debugging, not GrepSignal analysis.</p>
    <pre data-local-debug-raw></pre>
  </details>

  <p class="explain-error" data-local-explain-error hidden></p>
  <script is:inline type="application/json" data-local-explain-payload set:html={payload}></script>
</section>
</details>

<script>
  type ExplainTask = 'what_changed' | 'why_it_matters';
  type LocalAIState = {
    enabled: boolean;
    phase: string;
    modelId?: string | null;
  };
  type StreamUpdate = {
    task: ExplainTask;
    raw: string;
    visible: string;
    thinking: boolean;
    done: boolean;
  };
  type Manager = {
    getState: () => LocalAIState;
    generate: (
      task: ExplainTask,
      payload: unknown,
      onUpdate?: (update: StreamUpdate) => void,
    ) => Promise<string>;
  };
  type StepName = 'read' | 'changed' | 'matter';

  const getManager = async (): Promise<Manager> => {
    const current = (window as any).__grepsignalLocalAI as Manager | undefined;
    if (current) return current;
    return await new Promise((resolve) => {
      window.addEventListener('grepsignal:local-ai-manager-ready', () => {
        resolve((window as any).__grepsignalLocalAI as Manager);
      }, { once: true });
    });
  };

  const decodeGeneratedEntities = (value: string) => value
    .replace(/&#x([0-9a-f]+);/gi, (match, hex) => {
      const codePoint = Number.parseInt(hex, 16);
      return Number.isInteger(codePoint) && codePoint >= 0 && codePoint <= 0x10ffff
        ? String.fromCodePoint(codePoint)
        : match;
    })
    .replace(/&#([0-9]+);/g, (match, decimal) => {
      const codePoint = Number.parseInt(decimal, 10);
      return Number.isInteger(codePoint) && codePoint >= 0 && codePoint <= 0x10ffff
        ? String.fromCodePoint(codePoint)
        : match;
    })
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"')
    .replace(/&apos;/gi, "'")
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>');

  const cleanGeneratedText = (value: string) => decodeGeneratedEntities(value)
    .trim()
    .replace(/^['“"]+/, '')
    .replace(/['”"]+$/, '')
    .trim();

  document.querySelectorAll<HTMLElement>('[data-local-explain]').forEach((root) => {
    const run = root.querySelector<HTMLButtonElement>('[data-local-explain-run]');
    const output = root.querySelector<HTMLElement>('[data-local-explain-output]');
    const progress = root.querySelector<HTMLElement>('[data-local-progress]');
    const error = root.querySelector<HTMLElement>('[data-local-explain-error]');
    const payloadNode = root.querySelector<HTMLScriptElement>('[data-local-explain-payload]');
    const changed = root.querySelector<HTMLElement>('[data-local-explain-changed]');
    const matter = root.querySelector<HTMLElement>('[data-local-explain-matter]');
    const changedCard = root.querySelector<HTMLElement>('[data-local-explain-changed-card]');
    const matterCard = root.querySelector<HTMLElement>('[data-local-explain-matter-card]');
    const method = root.querySelector<HTMLDetailsElement>('[data-local-explain-method]');
    const modelId = root.querySelector<HTMLElement>('[data-local-model-id]');
    const debug = root.querySelector<HTMLDetailsElement>('[data-local-debug]');
    const debugRaw = root.querySelector<HTMLElement>('[data-local-debug-raw]');
    if (!run || !output || !progress || !error || !payloadNode || !changed || !matter || !changedCard || !matterCard || !method || !modelId || !debug || !debugRaw) return;

    const debugEnabled = new URLSearchParams(window.location.search).get('debug') === 'local-ai';
    debug.hidden = !debugEnabled;

    const step = (name: StepName) => root.querySelector<HTMLElement>(`[data-local-step="${name}"]`);
    const resetSteps = () => {
      (['read', 'changed', 'matter'] as StepName[]).forEach((name) => {
        const node = step(name);
        node?.classList.remove('is-active', 'is-done', 'is-failed');
        const marker = node?.querySelector('span');
        if (marker) marker.textContent = '·';
      });
    };
    const setStep = (name: StepName, state: 'active' | 'done' | 'failed') => {
      const node = step(name);
      if (!node) return;
      node.classList.remove('is-active', 'is-done', 'is-failed');
      node.classList.add(`is-${state}`);
      const marker = node.querySelector('span');
      if (marker) marker.textContent = state === 'done' ? '✓' : state === 'failed' ? '×' : '→';
    };

    const renderState = (state: { phase: string }) => {
      run.hidden = state.phase !== 'ready' && state.phase !== 'running';
      run.disabled = state.phase !== 'ready';
    };

    getManager().then((manager) => renderState(manager.getState()));
    window.addEventListener('grepsignal:local-ai-state', (event) => {
      renderState((event as CustomEvent).detail);
    });

    run.addEventListener('click', async () => {
      run.disabled = true;
      run.textContent = 'Explaining locally…';
      error.hidden = true;
      output.hidden = true;
      method.hidden = true;
      changedCard.hidden = true;
      matterCard.hidden = true;
      changed.textContent = '';
      matter.textContent = '';
      debugRaw.textContent = '';
      progress.hidden = false;
      resetSteps();
      setStep('read', 'done');

      const traces: Partial<Record<ExplainTask, { raw: string; visible: string }>> = {};
      const refreshDebug = () => {
        if (debugEnabled) debugRaw.textContent = JSON.stringify(traces, null, 2);
      };

      let activeStep: StepName = 'changed';
      try {
        const manager = await getManager();
        const payload = JSON.parse(payloadNode.textContent || '{}');

        setStep('changed', 'active');
        let changedRaw = '';
        const changedText = cleanGeneratedText(await manager.generate('what_changed', payload, (update) => {
          changedRaw = update.raw;
          traces.what_changed = { raw: update.raw, visible: update.visible };
          refreshDebug();
          const visible = cleanGeneratedText(update.visible);
          if (visible) {
            changed.textContent = visible;
            changedCard.hidden = false;
            output.hidden = false;
          }
        }));
        console.info('[GrepSignal Local AI] slot completion', {
          task: 'what_changed',
          modelId: manager.getState().modelId ?? null,
          raw: changedRaw,
          visible: changedText,
        });
        if (!changedText) throw new Error('Local AI could not produce a reliable What changed explanation.');
        changed.textContent = changedText;
        changedCard.hidden = false;
        output.hidden = false;
        setStep('changed', 'done');

        activeStep = 'matter';
        setStep('matter', 'active');
        let matterRaw = '';
        const matterText = cleanGeneratedText(await manager.generate('why_it_matters', payload, (update) => {
          matterRaw = update.raw;
          traces.why_it_matters = { raw: update.raw, visible: update.visible };
          refreshDebug();
          const visible = cleanGeneratedText(update.visible);
          if (visible) {
            matter.textContent = visible;
            matterCard.hidden = false;
          }
        }));
        console.info('[GrepSignal Local AI] slot completion', {
          task: 'why_it_matters',
          modelId: manager.getState().modelId ?? null,
          raw: matterRaw,
          visible: matterText,
        });
        if (!matterText) throw new Error('Local AI could not produce a reliable Why it matters explanation.');
        matter.textContent = matterText;
        matterCard.hidden = false;
        setStep('matter', 'done');

        modelId.textContent = manager.getState().modelId ?? 'the selected browser model';
        method.hidden = false;
      } catch (cause) {
        console.error('[GrepSignal Local AI] explanation failed', cause);
        setStep(activeStep, 'failed');
        output.hidden = true;
        error.textContent = cause instanceof Error
          ? `${cause.message} Please use the published signal.`
          : 'Local explanation failed. Please use the published signal.';
        error.hidden = false;
      } finally {
        run.textContent = 'Explain simply';
        const manager = (window as any).__grepsignalLocalAI as Manager | undefined;
        run.disabled = manager?.getState().phase !== 'ready';
      }
    });
  });
</script>

<style>
  .local-explain { margin: 0 0 42px; padding: 24px; border: 1px solid var(--ink); border-radius: var(--radius); background: #f4f1e9; }
  .explain-head { display: flex; justify-content: space-between; gap: 28px; align-items: flex-start; }
  .explain-head h2 { margin: 5px 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: 29px; line-height: 1.12; }
  .explain-head p { max-width: 650px; margin: 0; color: #3c3a35; line-height: 1.55; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  button { border-radius: 999px; padding: 10px 14px; font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; white-space: nowrap; }
  button.primary { border: 1px solid var(--accent); background: var(--accent); color: white; }
  button.secondary { border: 1px solid var(--ink); background: transparent; color: var(--ink); }
  button:disabled { cursor: default; opacity: .62; }
  button[hidden] { display: none; }
  .privacy-note { margin-top: 16px; padding-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font: 650 10px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .03em; }
  .local-progress { margin-top: 20px; padding: 17px 18px; border: 1px solid var(--line); border-radius: 8px; background: rgba(255,255,255,.44); }
  .local-progress ol { display: grid; gap: 7px; margin: 11px 0 0; padding: 0; list-style: none; }
  .local-progress li { display: flex; gap: 9px; align-items: baseline; color: var(--muted); font-size: 13px; }
  .local-progress li span { width: 14px; flex: 0 0 14px; font: 800 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .local-progress li.is-active { color: var(--accent); font-weight: 720; }
  .local-progress li.is-done { color: #34332f; }
  .local-progress li.is-failed { color: #8b2b24; }
  .local-progress p { margin: 11px 0 0; color: var(--muted); font-size: 11px; line-height: 1.45; }
  .explain-output { margin-top: 24px; }
  .generated-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .generated-grid article { border: 1px solid var(--line); background: rgba(255,255,255,.55); border-radius: 8px; padding: 16px; }
  .generated-grid span { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .05em; }
  .generated-grid p { margin: 8px 0 0; color: #34332f; line-height: 1.55; white-space: pre-wrap; }
  .generated-grid article[hidden] { display: none; }
  .keep-in-mind { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
  .keep-in-mind ul { margin: 10px 0 0; padding-left: 20px; color: #3d3b36; font-size: 14px; }
  .keep-in-mind li + li { margin-top: 8px; }
  .explain-method, .developer-trace { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px; }
  .explain-method summary, .developer-trace summary { cursor: pointer; color: var(--accent); font: 780 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .04em; }
  .explain-method ul { margin: 12px 0 0; padding-left: 20px; color: #3d3b36; font-size: 13px; line-height: 1.55; }
  .developer-trace p { margin: 10px 0; color: var(--muted); font-size: 12px; }
  .developer-trace pre { max-height: 320px; overflow: auto; margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 6px; background: #191815; color: #e8e3d8; white-space: pre-wrap; word-break: break-word; font: 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .generated-note, .explain-error { margin: 16px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .explain-error { color: #8b2b24; }
  @media (max-width: 760px) {
    .explain-head { flex-direction: column; }
    .actions { justify-content: flex-start; }
    .generated-grid { grid-template-columns: 1fr; }
  }
</style>

<style>
  .local-ai-shell {
    margin-top: 38px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  .local-ai-shell > summary {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: baseline;
    cursor: pointer;
    font-weight: 750;
  }
  .local-ai-shell > summary small {
    color: var(--muted);
    font: 700 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    text-align: right;
  }
  .local-ai-shell[open] > summary { margin-bottom: 18px; }
  @media (max-width: 620px) {
    .local-ai-shell > summary { align-items: flex-start; flex-direction: column; gap: 4px; }
    .local-ai-shell > summary small { text-align: left; }
  }
</style>

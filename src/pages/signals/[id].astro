---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalExplain from '../../components/LocalExplain.astro';
import ShareButton from '../../components/ShareButton.astro';
import intelligence from '../../data/intelligence';

type Signal = typeof intelligence.signals[number];
interface Props {
  signal: Signal;
}

export function getStaticPaths() {
  return intelligence.signals.map((signal) => ({
    params: { id: signal.id },
    props: { signal },
  }));
}

const { signal } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const isPublished = intelligence.publication_status === 'published';
const relatedThreads = intelligence.threads.filter((thread) => signal.thread_ids.includes(thread.id));
const typeLabels: Record<string, string> = {
  platform_shift: 'PLATFORM SHIFT',
  capability_delta: 'CAPABILITY DELTA',
  cost_intelligence: 'COST / INTELLIGENCE',
  ecosystem_momentum: 'ECOSYSTEM MOMENTUM',
  second_order_effect: 'SECOND-ORDER EFFECT',
};
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
  falsified: '×',
};
const roleLabels: Record<string, string> = {
  primary_incident_report: 'Incident report',
  primary_followup: 'Follow-up',
  primary_product_security: 'Product security',
  primary_incident_assessment: 'Incident assessment',
  primary_product_docs: 'Product docs',
  primary_product_release: 'Release notes',
  primary_historical_baseline: 'Historical baseline',
  primary_research_report: 'Research report',
  affected_party: 'Affected party',
};
const formatMonth = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', timeZone: 'UTC' })
    .format(new Date(Date.UTC(year, month - 1, 1)));
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: signal.title,
  description: signal.summary,
  identifier: signal.id,
  ...(signal.first_public_at ? { datePublished: signal.first_public_at } : {}),
  ...(signal.last_changed_at ? { dateModified: signal.last_changed_at } : {}),
  inLanguage: intelligence.canonical_language,
  articleSection: typeLabels[signal.type] ?? signal.type,
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Organization',
    name: 'GrepSignal',
  },
  publisher: {
    '@type': 'Organization',
    name: 'GrepSignal',
  },
  citation: signal.sources.map((source) => source.url),
};
---
<BaseLayout
  title={`${signal.title} — GrepSignal`}
  description={signal.summary}
  robots={isPublished ? 'index,follow' : 'noindex,nofollow'}
  ogType="article"
  publishedAt={signal.first_public_at ?? undefined}
  jsonLd={articleJsonLd}
  jsonAlternateHref={`${base}data/signals/${signal.id}.json`}
>
  <section class={`preview-notice ${isPublished ? 'live-notice' : ''}`} role="note">
    <div class="wrap">
      <strong>{isPublished ? 'LIVE INTELLIGENCE' : 'PREVIEW DATA'}</strong>
      <span>{intelligence.notice}</span>
    </div>
  </section>

  <main class="wrap signal-detail">
    <a class="back-link" href={`${base}signals/`}><span aria-hidden="true">←</span> All signals</a>

    <header class="detail-header">
      <div class="header-actions">
        <div class="tagrow">
          <span class="tag">{typeLabels[signal.type] ?? signal.type.toUpperCase()}</span>
          <span class={`status status-${signal.status}`}>
            {statusMark[signal.status] ?? '·'} {signal.status.toUpperCase()}
          </span>
        </div>
        <ShareButton title={`${signal.title} — GrepSignal`} url={canonicalUrl} />
      </div>
      <h1>{signal.title}</h1>
      <p class="lead">{signal.summary}</p>

      <dl class="signal-meta">
        <div>
          <dt>Registered</dt>
          <dd>{formatDate(signal.registered_at)}</dd>
        </div>
        <div>
          <dt>Evidence since</dt>
          <dd>{formatMonth(signal.evidence_since)}</dd>
        </div>
        <div>
          <dt>Linked sources</dt>
          <dd>{signal.source_count}</dd>
        </div>
        <div>
          <dt>Organizations</dt>
          <dd>{signal.source_organization_count}</dd>
        </div>
      </dl>
    </header>

    <div class="detail-grid">
      <div class="detail-main">
        {signal.lifecycle === 'active' && signal.status !== 'falsified' && !signal.review_required && <LocalExplain signal={signal} />}

        <section class="detail-section">
          <span class="section-kicker">INTERPRETATION</span>
          <h2>Why it matters</h2>
          <p>{signal.why_it_matters}</p>
        </section>

        <section class="detail-section second-order-section">
          <span class="section-kicker">SECOND-ORDER EFFECT</span>
          <h2>What changes next</h2>
          <p>{signal.second_order_effect}</p>
        </section>

        <section class="detail-section">
          <span class="section-kicker">MONITOR</span>
          <h2>Watch next</h2>
          <p>{signal.watch_next}</p>
        </section>

        <section class="detail-section" id="evidence">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">EVIDENCE</span>
              <h2>Linked sources</h2>
            </div>
            <span class="source-count">{signal.source_count} SOURCE{signal.source_count === 1 ? '' : 'S'}</span>
          </div>
          <ol class="source-list">
            {signal.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
                <div class="source-meta">
                  <span>{source.publisher}</span>
                  <span>{roleLabels[source.role] ?? source.role.replaceAll('_', ' ')}</span>
                  {source.published_at && <span>{source.published_at}</span>}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="review-grid" aria-label="Review notes">
          <div class="review-card">
            <span class="section-kicker">FALSIFIABILITY</span>
            <h2>What could falsify this</h2>
            <ul>{signal.falsifiers.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="review-card">
            <span class="section-kicker">BOUNDARIES</span>
            <h2>Limitations</h2>
            <ul>{signal.limitations.map((item) => <li>{item}</li>)}</ul>
          </div>
        </section>
      </div>

      <aside class="detail-sidebar" aria-label="Signal context">
        <div class="sidebar-block">
          <span class="label">Status</span>
          <strong>{statusMark[signal.status] ?? '·'} {signal.status}</strong>
        </div>
        {relatedThreads.length > 0 && (
          <div class="sidebar-block sidebar-related">
            <span class="label">Related Threads</span>
            {relatedThreads.map((thread) => (
              <a href={`${base}threads/${thread.id}/`}>{thread.title} →</a>
            ))}
          </div>
        )}
        <div class="sidebar-block">
          <span class="label">Record</span>
          <strong>Revision {signal.version}</strong>
          <span class="sidebar-note">Last reviewed {signal.last_reviewed_at ?? 'not recorded'}</span>
        </div>
        <div class="sidebar-block">
          <span class="label">Signal ID</span>
          <code>{signal.id}</code>
        </div>
        <div class="sidebar-block">
          <span class="label">Machine-readable</span>
          <a href={`${base}data/signals/${signal.id}.json`}>Open structured JSON →</a>
        </div>
      </aside>
    </div>
  </main>

  <footer>
    <div class="wrap footerline">
      <span>GrepSignal — structured intelligence for humans and agents.</span>
      <a href={`${base}#signals`}>Back to latest signals</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .live-notice strong { color: var(--accent); }
  .signal-detail { padding-top: 34px; padding-bottom: 90px; }
  .back-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--muted);
    font: 750 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--ink); }
  .detail-header {
    max-width: 980px;
    padding: 56px 0 42px;
    border-bottom: 1px solid var(--ink);
  }
  .header-actions { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .detail-header h1 {
    max-width: 960px;
    margin: 16px 0 20px;
    font-size: clamp(46px, 6vw, 76px);
    line-height: .99;
  }
  .lead { max-width: 860px; margin: 0; color: #383733; font-size: 21px; line-height: 1.55; }
  .signal-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 34px 0 0;
    border-top: 1px solid var(--line);
  }
  .signal-meta div { padding: 16px 18px 0 0; }
  .signal-meta dt { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .07em; }
  .signal-meta dd { margin: 5px 0 0; font-weight: 700; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 64px; padding-top: 46px; }
  .detail-main { min-width: 0; }
  .detail-section { padding: 0 0 38px; margin-bottom: 38px; border-bottom: 1px solid var(--line); }
  .detail-section h2, .review-card h2 { margin: 5px 0 13px; font-family: Georgia, 'Times New Roman', serif; font-size: 31px; line-height: 1.12; letter-spacing: -.02em; font-weight: 600; }
  .detail-section > p { max-width: 820px; margin: 0; color: #34332f; font-size: 18px; line-height: 1.65; }
  .second-order-section > p { color: var(--accent); font-weight: 720; font-size: 20px; }
  .section-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .source-count { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .07em; }
  .source-list { margin: 7px 0 0; padding: 0; list-style: none; counter-reset: evidence; }
  .source-list li {
    counter-increment: evidence;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .source-list li::before {
    content: counter(evidence, decimal-leading-zero);
    color: var(--muted);
    font: 650 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    padding-top: 4px;
  }
  .source-list a { font-family: Georgia, 'Times New Roman', serif; font-size: 20px; font-weight: 600; text-underline-offset: 4px; }
  .source-meta { grid-column: 2; display: flex; gap: 8px 14px; flex-wrap: wrap; margin-top: 5px; color: var(--muted); font-size: 12px; }
  .review-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .review-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .review-card h2 { font-size: 25px; }
  .review-card ul { margin: 14px 0 0; padding-left: 20px; color: #3d3b36; font-size: 14px; }
  .review-card li + li { margin-top: 11px; }
  .detail-sidebar { align-self: start; position: sticky; top: 104px; border-top: 1px solid var(--ink); }
  .sidebar-block { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .sidebar-block code { display: block; overflow-wrap: anywhere; font: 600 11px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; color: #34332f; }
  .sidebar-block strong { display: block; text-transform: capitalize; color: var(--accent); }
  .sidebar-block a { color: var(--accent); font-weight: 700; text-underline-offset: 3px; }
  .sidebar-related { display: grid; gap: 8px; }
  .sidebar-related .label { margin-bottom: 2px; }
  .sidebar-note { display: block; margin-top: 5px; color: var(--muted); font-size: 11px; line-height: 1.45; }
  footer a { color: inherit; }
  @media (max-width: 900px) {
    .signal-meta { grid-template-columns: 1fr 1fr; }
    .detail-grid { grid-template-columns: 1fr; gap: 42px; }
    .detail-sidebar { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; border-top: 1px solid var(--ink); }
    .sidebar-block { border-bottom: 0; }
  }
  @media (max-width: 620px) {
    .signal-detail { padding-top: 26px; padding-bottom: 64px; }
    .detail-header { padding-top: 40px; }
    .header-actions { align-items: flex-start; }
    .detail-header h1 { font-size: 43px; }
    .lead { font-size: 18px; }
    .signal-meta { grid-template-columns: 1fr 1fr; }
    .detail-grid { padding-top: 34px; }
    .review-grid, .detail-sidebar { grid-template-columns: 1fr; }
    .section-heading-row { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>
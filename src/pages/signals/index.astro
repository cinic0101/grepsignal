---
import BaseLayout from '../../layouts/BaseLayout.astro';
import intelligence from '../../data/intelligence.json';

const base = import.meta.env.BASE_URL;
const signals = [...intelligence.signals].sort((a, b) => b.registered_at.localeCompare(a.registered_at));
const typeLabels: Record<string, string> = {
  platform_shift: 'Platform Shift',
  capability_delta: 'Capability Delta',
  cost_intelligence: 'Cost / Intelligence',
  ecosystem_momentum: 'Ecosystem Momentum',
  second_order_effect: 'Second-order Effect',
};
const typeOptions = [
  ['all', 'All'],
  ['capability_delta', 'Capability Delta'],
  ['platform_shift', 'Platform Shift'],
  ['second_order_effect', 'Second-order Effect'],
  ['cost_intelligence', 'Cost / Intelligence'],
  ['ecosystem_momentum', 'Ecosystem Momentum'],
] as const;
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---
<BaseLayout
  title="Signals — GrepSignal"
  description="Browse GrepSignal's published AI-era intelligence by signal type, status, time window, or search."
>
  <main class="wrap archive-page" data-signal-archive>
    <header class="archive-hero">
      <span class="section-kicker">INTELLIGENCE ARCHIVE</span>
      <h1>Signals</h1>
      <p>
        Material changes that passed GrepSignal's evidence-backed publication gate.
        Filter the archive without changing what qualifies as a signal.
      </p>
    </header>

    <section class="archive-controls" aria-label="Signal filters">
      <div class="search-row">
        <label class="search-field">
          <span>Search</span>
          <input
            type="search"
            placeholder="Search title, summary, why it matters"
            autocomplete="off"
            data-signal-search
          />
        </label>
        <button class="reset-button" type="button" data-filter-reset>Reset</button>
      </div>

      <div class="filter-group">
        <span class="filter-label">Type</span>
        <div class="type-chips" role="group" aria-label="Signal type">
          {typeOptions.map(([value, label]) => (
            <button
              type="button"
              class="filter-chip"
              data-type-filter={value}
              aria-pressed={value === 'all' ? 'true' : 'false'}
            >
              {label}
            </button>
          ))}
        </div>
      </div>

      <div class="select-row">
        <label>
          <span class="filter-label">Status</span>
          <select data-status-filter>
            <option value="all">All statuses</option>
            <option value="emerging">Emerging</option>
            <option value="strengthening">Strengthening</option>
            <option value="stable">Stable</option>
            <option value="weakening">Weakening</option>
          </select>
        </label>
        <label>
          <span class="filter-label">Time</span>
          <select data-time-filter>
            <option value="90d">Last 90 days</option>
            <option value="all">All time</option>
          </select>
        </label>
        <div class="result-count" data-result-count aria-live="polite"></div>
      </div>
    </section>

    <section class="archive-results" aria-label="Published signals">
      <div class="archive-list">
        {signals.map((signal, index) => (
          <article
            class="archive-signal"
            data-signal-card
            data-type={signal.type}
            data-status={signal.status}
            data-date={signal.registered_at}
            data-search={`${signal.title} ${signal.summary} ${signal.why_it_matters}`.toLowerCase()}
          >
            <div class="archive-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="archive-main">
              <div class="tagrow">
                <span class="tag">{typeLabels[signal.type] ?? signal.type}</span>
                <span class={`status status-${signal.status}`}>
                  {statusMark[signal.status] ?? '·'} {signal.status.toUpperCase()}
                </span>
              </div>
              <h2><a href={`${base}signals/${signal.id}/`}>{signal.title}</a></h2>
              <p class="archive-summary">{signal.summary}</p>
              <div class="archive-meta">
                {signal.source_count} linked source{signal.source_count === 1 ? '' : 's'} · {signal.source_organization_count} source organization{signal.source_organization_count === 1 ? '' : 's'} · registered {formatDate(signal.registered_at)}
              </div>
              <a class="archive-link" href={`${base}signals/${signal.id}/`}>
                View signal <span aria-hidden="true">→</span>
              </a>
            </div>
            <aside class="archive-why">
              <span class="label">Why it matters</span>
              <p>{signal.why_it_matters}</p>
            </aside>
          </article>
        ))}
      </div>

      <div class="archive-empty" data-empty-state hidden>
        No signals match these filters.
      </div>

      <nav class="pager" aria-label="Signal archive pagination" data-pager hidden>
        <button type="button" data-page-prev>← Previous</button>
        <span data-page-status></span>
        <button type="button" data-page-next>Next →</button>
      </nav>
    </section>
  </main>

  <footer>
    <div class="wrap footerline">
      <span>GrepSignal — structured intelligence for humans and agents.</span>
      <span>Link to evidence. Don’t mirror it.</span>
    </div>
  </footer>
</BaseLayout>

<script>
  const root = document.querySelector('[data-signal-archive]');

  if (root) {
    const PAGE_SIZE = 10;
    const cards = Array.from(root.querySelectorAll('[data-signal-card]'));
    const searchInput = root.querySelector('[data-signal-search]');
    const typeButtons = Array.from(root.querySelectorAll('[data-type-filter]'));
    const statusSelect = root.querySelector('[data-status-filter]');
    const timeSelect = root.querySelector('[data-time-filter]');
    const resetButton = root.querySelector('[data-filter-reset]');
    const resultCount = root.querySelector('[data-result-count]');
    const emptyState = root.querySelector('[data-empty-state]');
    const pager = root.querySelector('[data-pager]');
    const prevButton = root.querySelector('[data-page-prev]');
    const nextButton = root.querySelector('[data-page-next]');
    const pageStatus = root.querySelector('[data-page-status]');

    const validTypes = new Set(['all', 'capability_delta', 'platform_shift', 'second_order_effect', 'cost_intelligence', 'ecosystem_momentum']);
    const validStatuses = new Set(['all', 'emerging', 'strengthening', 'stable', 'weakening']);
    const validTimes = new Set(['90d', 'all']);

    const state = {
      q: '',
      type: 'all',
      status: 'all',
      time: '90d',
      page: 1,
    };

    const setTypeButtonState = () => {
      typeButtons.forEach((button) => {
        const active = button.dataset.typeFilter === state.type;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    const syncUrl = () => {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.type !== 'all') params.set('type', state.type);
      if (state.status !== 'all') params.set('status', state.status);
      if (state.time !== '90d') params.set('time', state.time);
      if (state.page > 1) params.set('page', String(state.page));
      const query = params.toString();
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}`);
    };

    const applyFilters = ({ keepPage = false, updateUrl = true } = {}) => {
      if (!keepPage) state.page = 1;
      const query = state.q.trim().toLowerCase();
      const cutoff = Date.now() - (90 * 24 * 60 * 60 * 1000);

      const filtered = cards.filter((card) => {
        const matchesQuery = !query || (card.dataset.search || '').includes(query);
        const matchesType = state.type === 'all' || card.dataset.type === state.type;
        const matchesStatus = state.status === 'all' || card.dataset.status === state.status;
        const registeredAt = Date.parse(`${card.dataset.date}T00:00:00Z`);
        const matchesTime = state.time === 'all' || registeredAt >= cutoff;
        return matchesQuery && matchesType && matchesStatus && matchesTime;
      });

      const pageCount = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      state.page = Math.min(Math.max(1, state.page), pageCount);
      const start = (state.page - 1) * PAGE_SIZE;
      const visible = new Set(filtered.slice(start, start + PAGE_SIZE));

      cards.forEach((card) => {
        card.hidden = !visible.has(card);
      });

      resultCount.textContent = `${filtered.length} of ${cards.length} signal${cards.length === 1 ? '' : 's'}`;
      emptyState.hidden = filtered.length !== 0;
      pager.hidden = filtered.length <= PAGE_SIZE;
      pageStatus.textContent = `Page ${state.page} of ${pageCount}`;
      prevButton.disabled = state.page <= 1;
      nextButton.disabled = state.page >= pageCount;

      if (updateUrl) syncUrl();
    };

    const hydrateFromUrl = () => {
      const params = new URLSearchParams(location.search);
      state.q = params.get('q') || '';
      state.type = validTypes.has(params.get('type')) ? params.get('type') : 'all';
      state.status = validStatuses.has(params.get('status')) ? params.get('status') : 'all';
      state.time = validTimes.has(params.get('time')) ? params.get('time') : '90d';
      const requestedPage = Number.parseInt(params.get('page') || '1', 10);
      state.page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

      searchInput.value = state.q;
      statusSelect.value = state.status;
      timeSelect.value = state.time;
      setTypeButtonState();
      applyFilters({ keepPage: true, updateUrl: false });
    };

    searchInput.addEventListener('input', () => {
      state.q = searchInput.value;
      applyFilters();
    });

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        state.type = button.dataset.typeFilter || 'all';
        setTypeButtonState();
        applyFilters();
      });
    });

    statusSelect.addEventListener('change', () => {
      state.status = statusSelect.value;
      applyFilters();
    });

    timeSelect.addEventListener('change', () => {
      state.time = timeSelect.value;
      applyFilters();
    });

    resetButton.addEventListener('click', () => {
      state.q = '';
      state.type = 'all';
      state.status = 'all';
      state.time = '90d';
      state.page = 1;
      searchInput.value = '';
      statusSelect.value = 'all';
      timeSelect.value = '90d';
      setTypeButtonState();
      applyFilters({ keepPage: true });
    });

    prevButton.addEventListener('click', () => {
      state.page -= 1;
      applyFilters({ keepPage: true });
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    nextButton.addEventListener('click', () => {
      state.page += 1;
      applyFilters({ keepPage: true });
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    addEventListener('popstate', hydrateFromUrl);
    hydrateFromUrl();
  }
</script>

<style>
  .archive-page { padding-top: 70px; padding-bottom: 90px; }
  .archive-hero { max-width: 780px; margin-bottom: 38px; }
  .archive-hero h1 { margin: 6px 0 18px; font-size: clamp(52px, 7vw, 82px); }
  .archive-hero p { margin: 0; color: #3d3b36; font-size: 19px; }

  .archive-controls {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    padding: 22px 0 24px;
    display: grid;
    gap: 20px;
  }
  .search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: end; }
  .search-field { display: grid; gap: 7px; }
  .search-field > span, .filter-label {
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  input[type='search'], select {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
    border-radius: 9px;
    min-height: 42px;
    padding: 9px 11px;
    font: inherit;
  }
  input[type='search']:focus, select:focus, button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    outline-offset: 2px;
  }
  .reset-button, .pager button {
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
    border-radius: 9px;
    min-height: 42px;
    padding: 9px 13px;
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    cursor: pointer;
  }
  .reset-button:hover, .pager button:hover:not(:disabled) { border-color: var(--ink); }
  .filter-group { display: grid; gap: 9px; }
  .type-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    padding: 7px 10px;
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .02em;
    cursor: pointer;
  }
  .filter-chip[aria-pressed='true'] { border-color: var(--accent); background: var(--accent); color: #fff; }
  .select-row { display: grid; grid-template-columns: minmax(150px, 220px) minmax(150px, 220px) 1fr; gap: 14px; align-items: end; }
  .select-row label { display: grid; gap: 7px; }
  .result-count { justify-self: end; align-self: center; color: var(--muted); font-size: 12px; }

  .archive-list { border-top: 1px solid var(--ink); margin-top: 42px; }
  .archive-signal {
    display: grid;
    grid-template-columns: 54px minmax(0, 1.4fr) minmax(250px, .65fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .archive-signal[hidden] { display: none; }
  .archive-index { font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); padding-top: 4px; }
  .archive-main h2 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 29px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -.025em;
    margin: 0 0 11px;
  }
  .archive-main h2 a { text-decoration: none; }
  .archive-main h2 a:hover, .archive-main h2 a:focus-visible { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .archive-summary { margin: 0 0 12px; color: #3d3b36; font-size: 15px; }
  .archive-meta { color: var(--muted); font-size: 12px; }
  .archive-link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    margin-top: 13px;
    color: var(--accent);
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .archive-link:hover, .archive-link:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
  .archive-why { border-left: 1px solid var(--line); padding-left: 22px; font-size: 13px; color: #3d3b36; }
  .archive-why p {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }
  .archive-empty { padding: 50px 0; color: var(--muted); font-family: Georgia, serif; font-size: 24px; border-bottom: 1px solid var(--line); }
  .pager { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 30px; }
  .pager span { min-width: 110px; text-align: center; color: var(--muted); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .pager button:disabled { opacity: .45; cursor: default; }

  @media (max-width: 900px) {
    .archive-signal { grid-template-columns: 42px 1fr; }
    .archive-why { grid-column: 2; border-left: 0; border-top: 1px dashed var(--line); padding: 16px 0 0; }
  }

  @media (max-width: 620px) {
    .archive-page { padding-top: 46px; padding-bottom: 70px; }
    .archive-hero p { font-size: 17px; }
    .search-row, .select-row { grid-template-columns: 1fr; }
    .result-count { justify-self: start; }
    .archive-signal { grid-template-columns: 1fr; gap: 9px; }
    .archive-why { grid-column: 1; }
    .archive-main h2 { font-size: 26px; }
    .pager { gap: 8px; }
    .pager button { padding-left: 9px; padding-right: 9px; }
  }
</style>

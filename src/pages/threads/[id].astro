---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import intelligence from '../../data/intelligence.json';
import threadLinks from '../../data/thread-links.json';

type Thread = typeof intelligence.threads[number];
type Signal = typeof intelligence.signals[number];
type ThreadRevision = Thread['updates'][number] & {
  pattern_scope?: 'cross_actor' | 'same_actor' | 'mixed' | 'unclear';
  event_independence?: 'independent_events' | 'same_event_repeated' | 'mixed' | 'unclear';
  mechanism_coherence?: 'strong' | 'partial' | 'weak' | 'unclear';
};
interface Props {
  thread: Thread;
  supporting: Signal[];
  contradicting: Signal[];
}

export function getStaticPaths() {
  const signalById = new Map(intelligence.signals.map((signal) => [signal.id, signal]));
  return intelligence.threads.map((thread) => {
    const relation = threadLinks[thread.id as keyof typeof threadLinks];
    const supporting = (relation?.supporting ?? []).map((id) => signalById.get(id)).filter(Boolean) as Signal[];
    const contradicting = (relation?.contradicting ?? []).map((id) => signalById.get(id)).filter(Boolean) as Signal[];
    return { params: { id: thread.id }, props: { thread, supporting, contradicting } };
  });
}

const { thread, supporting, contradicting } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const signalById = new Map(intelligence.signals.map((signal) => [signal.id, signal]));
const updates = ([...thread.updates] as ThreadRevision[]).sort((a, b) => b.date.localeCompare(a.date));
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---
<BaseLayout
  title={`${thread.title} — GrepSignal thread`}
  description={thread.summary}
>
  <main class="wrap thread-detail">
    <a class="back-link" href={`${base}threads/`}><span aria-hidden="true">←</span> All threads</a>

    <header class="thread-header">
      <div class="status-row">
        <span class={`status status-${thread.status}`}>{statusMark[thread.status] ?? '·'} {thread.status.toUpperCase()}</span>
        <ShareButton title={`${thread.title} — GrepSignal`} url={canonicalUrl} />
      </div>
      <h1>{thread.title}</h1>
      <p class="lead">{thread.summary}</p>
      <dl class="thread-meta">
        <div><dt>Created</dt><dd>{formatDate(thread.created_at)}</dd></div>
        <div><dt>Last updated</dt><dd>{formatDate(thread.last_updated)}</dd></div>
        <div><dt>Linked signals</dt><dd>{supporting.length + contradicting.length}</dd></div>
      </dl>
    </header>

    <div class="thread-grid">
      <div>
        <section class="detail-section thesis-section">
          <span class="section-kicker">CURRENT THESIS</span>
          <h2>What this thread is tracking</h2>
          <p>{thread.thesis ?? thread.summary}</p>
        </section>

        <section class="detail-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">SUPPORTING EVIDENCE</span>
              <h2>Signals supporting this thesis</h2>
            </div>
            <span class="count">{supporting.length}</span>
          </div>
          {supporting.length === 0 ? (
            <p class="empty">No supporting signal is linked in the current public revision.</p>
          ) : (
            <div class="signal-list">
              {supporting.map((signal) => (
                <article>
                  <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                  <p>{signal.summary}</p>
                  <span>{signal.status} · registered {formatDate(signal.registered_at)}</span>
                </article>
              ))}
            </div>
          )}
        </section>

        <section class="detail-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">CONTRADICTING EVIDENCE</span>
              <h2>Signals pushing against this thesis</h2>
            </div>
            <span class="count">{contradicting.length}</span>
          </div>
          {contradicting.length === 0 ? (
            <p class="empty">No contradicting signal is linked in the current public revision.</p>
          ) : (
            <div class="signal-list">
              {contradicting.map((signal) => (
                <article>
                  <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                  <p>{signal.summary}</p>
                  <span>{signal.status} · registered {formatDate(signal.registered_at)}</span>
                </article>
              ))}
            </div>
          )}
        </section>

        <section class="detail-section history-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">CHANGE HISTORY</span>
              <h2>How this thesis has changed</h2>
            </div>
            <span class="count">{updates.length} revision{updates.length === 1 ? '' : 's'}</span>
          </div>
          <p class="history-intro">A Thread revision is added only when reviewed evidence materially changes the tracked interpretation. New coverage alone is not a revision.</p>
          <div class="timeline">
            {updates.map((update, index) => {
              const linkedSignals = update.signal_ids
                .map((id) => signalById.get(id))
                .filter(Boolean) as Signal[];
              return (
                <article class="timeline-item">
                  <div class="timeline-rail" aria-hidden="true">
                    <span class="timeline-dot"></span>
                    {index < updates.length - 1 && <span class="timeline-line"></span>}
                  </div>
                  <div class="timeline-body">
                    <div class="timeline-meta">
                      <time datetime={update.date}>{formatDate(update.date)}</time>
                      <span>{statusMark[update.assessment] ?? '·'} {update.assessment}</span>
                    </div>
                    <p class="timeline-change">{update.change}</p>
                    {(update.pattern_scope || update.event_independence || update.mechanism_coherence) && (
                      <div class="pattern-tags" aria-label="Revision interpretation">
                        {update.pattern_scope && <span>{update.pattern_scope.replace('_', ' ')}</span>}
                        {update.event_independence && <span>{update.event_independence.replaceAll('_', ' ')}</span>}
                        {update.mechanism_coherence && <span>mechanism: {update.mechanism_coherence}</span>}
                      </div>
                    )}
                    {(linkedSignals.length > 0 || update.sources.length > 0) && (
                      <div class="revision-evidence">
                        <strong>Reviewed provenance</strong>
                        {linkedSignals.map((signal) => (
                          <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                        ))}
                        {update.sources.map((source) => (
                          <a href={source.url} rel="noreferrer">{source.publisher} — {source.title}</a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </div>

      <aside class="sidebar">
        <div><span>Thread ID</span><code>{thread.id}</code></div>
        <div><span>Status</span><strong>{statusMark[thread.status] ?? '·'} {thread.status}</strong></div>
        <div><span>Evidence since</span><strong>{thread.evidence_since}</strong></div>
        <div><span>Machine-readable</span><a href={`${base}data/intelligence.json`}>Open JSON →</a></div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .thread-detail { padding-top: 34px; padding-bottom: 100px; }
  .back-link { display: inline-flex; gap: 8px; color: var(--muted); font: 750 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-decoration: none; }
  .thread-header { max-width: 980px; padding: 54px 0 42px; border-bottom: 1px solid var(--ink); }
  .status-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .status { color: var(--accent); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .06em; }
  .thread-header h1 { margin: 16px 0 20px; font-size: clamp(48px, 7vw, 78px); line-height: .98; }
  .lead { max-width: 860px; margin: 0; color: #383733; font-size: 21px; line-height: 1.55; }
  .thread-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 32px 0 0; border-top: 1px solid var(--line); }
  .thread-meta div { padding: 15px 18px 0 0; }
  .thread-meta dt, .sidebar span { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .07em; }
  .thread-meta dd { margin: 5px 0 0; font-weight: 700; }
  .thread-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 64px; padding-top: 46px; }
  .detail-section { padding-bottom: 38px; margin-bottom: 38px; border-bottom: 1px solid var(--line); }
  .detail-section h2 { margin: 5px 0 13px; font-family: Georgia, 'Times New Roman', serif; font-size: 31px; line-height: 1.12; }
  .detail-section > p { max-width: 820px; color: #34332f; font-size: 18px; line-height: 1.65; }
  .thesis-section > p { color: var(--accent); font-size: 20px; font-weight: 720; }
  .section-heading-row { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .count { color: var(--muted); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .signal-list article { padding: 20px 0; border-top: 1px solid var(--line); }
  .signal-list a { font-family: Georgia, 'Times New Roman', serif; font-size: 21px; font-weight: 650; text-underline-offset: 4px; }
  .signal-list p { max-width: 780px; margin: 8px 0; color: #3c3b37; line-height: 1.55; }
  .signal-list span { color: var(--muted); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
  .empty { color: var(--muted) !important; font-size: 15px !important; }
  .history-intro { margin: 0 0 24px; color: var(--muted) !important; font-size: 15px !important; }
  .timeline { border-top: 1px solid var(--line); }
  .timeline-item { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 14px; padding-top: 24px; }
  .timeline-rail { display: flex; flex-direction: column; align-items: center; }
  .timeline-dot { width: 9px; height: 9px; border: 2px solid var(--ink); border-radius: 50%; background: var(--paper); margin-top: 4px; flex: 0 0 auto; }
  .timeline-line { width: 1px; min-height: 100%; flex: 1 1 auto; background: var(--line); margin-top: 7px; }
  .timeline-body { min-width: 0; padding-bottom: 30px; }
  .timeline-meta { display: flex; flex-wrap: wrap; gap: 10px 16px; color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .05em; }
  .timeline-change { max-width: 800px; margin: 9px 0 0; color: #34332f; font-size: 17px; line-height: 1.62; }
  .pattern-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
  .pattern-tags span { border: 1px solid var(--line); border-radius: 999px; padding: 5px 8px; color: var(--muted); font: 750 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .04em; }
  .revision-evidence { display: grid; gap: 6px; margin-top: 16px; padding: 13px 15px; background: var(--panel); border-left: 2px solid var(--line); }
  .revision-evidence strong { color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .revision-evidence a { width: fit-content; max-width: 100%; color: var(--accent); font-size: 13px; font-weight: 700; overflow-wrap: anywhere; text-underline-offset: 3px; }
  .sidebar { align-self: start; position: sticky; top: 104px; border-top: 1px solid var(--ink); }
  .sidebar div { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .sidebar span { display: block; margin-bottom: 6px; }
  .sidebar code { display: block; overflow-wrap: anywhere; font: 600 11px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .sidebar strong { color: var(--accent); text-transform: capitalize; }
  .sidebar a { color: var(--accent); font-weight: 700; }
  @media (max-width: 900px) {
    .thread-grid { grid-template-columns: 1fr; gap: 40px; }
    .sidebar { position: static; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .sidebar div { border-bottom: 0; }
  }
  @media (max-width: 620px) {
    .thread-header { padding-top: 40px; }
    .status-row { align-items: flex-start; }
    .thread-meta, .sidebar { grid-template-columns: 1fr; }
    .section-heading-row { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>

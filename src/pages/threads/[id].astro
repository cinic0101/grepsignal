---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import LocalThreadExplain from '../../components/LocalThreadExplain.astro';
import intelligence from '../../data/intelligence';
import threadLinks from '../../data/thread-links';

type Thread = typeof intelligence.threads[number];
type Signal = typeof intelligence.signals[number];
type ThreadRevision = Thread['updates'][number] & {
  pattern_scope?: 'cross_actor' | 'same_actor' | 'mixed' | 'unclear';
  event_independence?: 'independent_events' | 'same_event_repeated' | 'mixed' | 'unclear';
  mechanism_coherence?: 'strong' | 'partial' | 'weak' | 'unclear';
};
type ThreadAnalysis = {
  evidence_map: Array<{
    id: string;
    title: string;
    summary: string;
    signal_ids: string[];
  }>;
  boundaries: string[];
  view_tests: {
    strengthen: string[];
    weaken: string[];
  };
};
type ThreadWithAnalysis = Thread & { analysis?: ThreadAnalysis };

interface Props {
  thread: Thread;
  supporting: Signal[];
  contradicting: Signal[];
}

export function getStaticPaths() {
  const signalById = new Map(intelligence.signals.map((signal) => [signal.id, signal]));
  return intelligence.threads.map((thread) => {
    const relation = threadLinks[thread.id as keyof typeof threadLinks];
    const supporting = (relation?.supporting ?? []).map((id) => signalById.get(id)).filter(Boolean) as Signal[];
    const contradicting = (relation?.contradicting ?? []).map((id) => signalById.get(id)).filter(Boolean) as Signal[];
    return { params: { id: thread.id }, props: { thread, supporting, contradicting } };
  });
}

const { thread: rawThread, supporting, contradicting } = Astro.props as Props;
const thread = rawThread as ThreadWithAnalysis;
const base = import.meta.env.BASE_URL;
const signalById = new Map(intelligence.signals.map((signal) => [signal.id, signal]));
const updates = ([...thread.updates].reverse() as ThreadRevision[]).sort((a, b) => b.date.localeCompare(a.date));
const latestUpdate = updates[0];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const linkedSignalCount = supporting.length + contradicting.length;
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
  falsified: '×',
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---
<BaseLayout
  title={`${thread.title} — GrepSignal thread`}
  description={thread.summary}
>
  <main class="wrap thread-detail">
    <a class="back-link" href={`${base}threads/`}><span aria-hidden="true">←</span> All threads</a>

    <header class="thread-header">
      <div class="status-row">
        <span class={`status status-${thread.status}`}>{statusMark[thread.status] ?? '·'} {thread.status.toUpperCase()}</span>
        <ShareButton title={`${thread.title} — GrepSignal`} url={canonicalUrl} />
      </div>
      <h1>{thread.title}</h1>
      <p class="lead">{thread.summary}</p>
      <dl class="thread-meta">
        <div><dt>Evidence since</dt><dd>{thread.evidence_since}</dd></div>
        <div><dt>Revisions</dt><dd>{updates.length}</dd></div>
        <div><dt>Linked signals</dt><dd>{linkedSignalCount}</dd></div>
        <div><dt>Last updated</dt><dd>{formatDate(thread.last_updated)}</dd></div>
      </dl>
    </header>

    <section class="thesis-callout" id="thesis">
      <span class="section-kicker">CURRENT THESIS</span>
      <p>{thread.thesis ?? thread.summary}</p>
    </section>

    <nav class="thread-section-nav" aria-label="Thread sections">
      <a href="#thesis">Current thesis</a>
      {latestUpdate && <a href="#latest-change">Latest change</a>}
      {thread.analysis && <a href="#evidence-pattern">Evidence</a>}
      {thread.analysis && <a href="#boundaries">Boundaries</a>}
      {thread.analysis && <a href="#view-tests">View tests</a>}
      <a href="#related-signals">Signals</a>
      <a href="#history">History</a>
    </nav>

    <div class="thread-grid">
      <div>
        {latestUpdate && (
          <section class="latest-change" id="latest-change">
            <div class="latest-change-head">
              <div>
                <span class="section-kicker">LATEST CHANGE</span>
                <h2>Why our view changed</h2>
              </div>
              <div class="latest-stamp">
                <time datetime={latestUpdate.date}>{formatDate(latestUpdate.date)}</time>
                <span>{statusMark[latestUpdate.assessment] ?? '·'} {latestUpdate.assessment}</span>
              </div>
            </div>
            <p>{latestUpdate.change}</p>
            {(latestUpdate.pattern_scope || latestUpdate.event_independence || latestUpdate.mechanism_coherence) && (
              <div class="interpretation-strip" aria-label="Latest revision interpretation">
                {latestUpdate.pattern_scope && (
                  <div><span>Pattern</span><strong>{latestUpdate.pattern_scope.replace('_', ' ')}</strong></div>
                )}
                {latestUpdate.event_independence && (
                  <div><span>Event relationship</span><strong>{latestUpdate.event_independence.replaceAll('_', ' ')}</strong></div>
                )}
                {latestUpdate.mechanism_coherence && (
                  <div><span>Mechanism</span><strong>{latestUpdate.mechanism_coherence}</strong></div>
                )}
                <div><span>Effect on thesis</span><strong>{latestUpdate.assessment}</strong></div>
              </div>
            )}
          </section>
        )}

        {thread.lifecycle === 'active' && thread.status !== 'falsified' && !thread.review_required && <LocalThreadExplain thread={thread} />}

        {thread.analysis && (
          <section class="detail-section evidence-map-section" id="evidence-pattern">
            <span class="section-kicker">WHAT WE SEE</span>
            <h2>The evidence pattern</h2>
            <p class="section-intro">This is the current analytical structure behind the Thread, not a count-based score.</p>
            <div class="evidence-map">
              {thread.analysis.evidence_map.map((dimension) => {
                const linked = dimension.signal_ids
                  .map((id) => signalById.get(id))
                  .filter(Boolean) as Signal[];
                return (
                  <article class="evidence-dimension">
                    <span class="dimension-index">{dimension.id.replaceAll('-', ' ')}</span>
                    <h3>{dimension.title}</h3>
                    <p>{dimension.summary}</p>
                    {linked.length > 0 && (
                      <div class="dimension-links">
                        {linked.map((signal) => (
                          <a href={`${base}signals/${signal.id}/`}>↳ {signal.title}</a>
                        ))}
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )}

        {thread.analysis && (
          <section class="detail-section guardrail-section" id="boundaries">
            <span class="section-kicker">BOUNDARIES</span>
            <h2>What this does not mean</h2>
            <div class="boundary-list">
              {thread.analysis.boundaries.map((boundary) => (
                <div class="boundary-item">
                  <span aria-hidden="true">≠</span>
                  <p>{boundary}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {thread.analysis && (
          <section class="detail-section view-tests-section" id="view-tests">
            <span class="section-kicker">WHAT WOULD CHANGE OUR VIEW</span>
            <h2>Evidence that would move this Thread</h2>
            <div class="view-tests">
              <div class="view-column">
                <div class="view-heading"><span>↑</span><strong>Would strengthen</strong></div>
                <ul>
                  {thread.analysis.view_tests.strengthen.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div class="view-column">
                <div class="view-heading"><span>↓</span><strong>Would weaken</strong></div>
                <ul>
                  {thread.analysis.view_tests.weaken.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </section>
        )}

        <section class="detail-section" id="related-signals">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">RELATED SIGNALS</span>
              <h2>Material changes linked to this thesis</h2>
            </div>
            <span class="count">{linkedSignalCount}</span>
          </div>
          {supporting.length === 0 ? (
            <p class="empty">No supporting Signal is linked in the current public revision.</p>
          ) : (
            <div class="signal-list">
              {supporting.map((signal) => (
                <article>
                  <div class="signal-relation">SUPPORTING</div>
                  <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                  <p>{signal.summary}</p>
                  <span>{signal.status} · registered {formatDate(signal.registered_at)}</span>
                </article>
              ))}
            </div>
          )}
          {contradicting.length > 0 && (
            <div class="signal-list contradicting-list">
              {contradicting.map((signal) => (
                <article>
                  <div class="signal-relation">CONTRADICTING</div>
                  <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                  <p>{signal.summary}</p>
                  <span>{signal.status} · registered {formatDate(signal.registered_at)}</span>
                </article>
              ))}
            </div>
          )}
        </section>

        <section class="detail-section history-section" id="history">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">CHANGE HISTORY</span>
              <h2>How this thesis has changed</h2>
            </div>
            <span class="count">{updates.length} revision{updates.length === 1 ? '' : 's'}</span>
          </div>
          <p class="history-intro">A Thread revision is added only when reviewed evidence materially changes the tracked interpretation. New coverage alone is not a revision.</p>
          <div class="timeline">
            {updates.map((update, index) => {
              const linkedSignals = update.signal_ids
                .map((id) => signalById.get(id))
                .filter(Boolean) as Signal[];
              return (
                <article class="timeline-item">
                  <div class="timeline-rail" aria-hidden="true">
                    <span class="timeline-dot"></span>
                    {index < updates.length - 1 && <span class="timeline-line"></span>}
                  </div>
                  <div class="timeline-body">
                    <div class="timeline-meta">
                      <time datetime={update.date}>{formatDate(update.date)}</time>
                      <span>{statusMark[update.assessment] ?? '·'} {update.assessment}</span>
                    </div>
                    <p class="timeline-change">{update.change}</p>
                    {(update.pattern_scope || update.event_independence || update.mechanism_coherence) && (
                      <div class="pattern-tags" aria-label="Revision interpretation">
                        {update.pattern_scope && <span>{update.pattern_scope.replace('_', ' ')}</span>}
                        {update.event_independence && <span>{update.event_independence.replaceAll('_', ' ')}</span>}
                        {update.mechanism_coherence && <span>mechanism: {update.mechanism_coherence}</span>}
                      </div>
                    )}
                    {(linkedSignals.length > 0 || update.sources.length > 0) && (
                      <div class="revision-evidence">
                        <strong>Reviewed provenance</strong>
                        {linkedSignals.map((signal) => (
                          <a href={`${base}signals/${signal.id}/`}>{signal.title}</a>
                        ))}
                        {update.sources.map((source) => (
                          <a href={source.url} rel="noreferrer">{source.publisher} — {source.title}</a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      </div>

      <aside class="sidebar">
        <div><span>Thread ID</span><code>{thread.id}</code></div>
        <div><span>Status</span><strong>{statusMark[thread.status] ?? '·'} {thread.status}</strong></div>
        <div><span>Created</span><strong>{formatDate(thread.created_at)}</strong></div>
        <div><span>Last updated</span><strong>{formatDate(thread.last_updated)}</strong></div>
        <div><span>Evidence since</span><strong>{thread.evidence_since}</strong></div>
        <div><span>Signals</span><strong>{linkedSignalCount}</strong></div>
        <div><span>Revisions</span><strong>{updates.length}</strong></div>
        <div><span>Machine-readable</span><a href={`${base}data/intelligence.json`}>Open JSON →</a></div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .thread-detail { padding-top: 34px; padding-bottom: 100px; }
  .back-link { display: inline-flex; gap: 8px; color: var(--muted); font: 750 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-decoration: none; }
  .thread-header { max-width: 1040px; padding: 54px 0 42px; border-bottom: 1px solid var(--ink); }
  .status-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .status { color: var(--accent); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .06em; }
  .thread-header h1 { margin: 16px 0 20px; font-size: clamp(48px, 7vw, 78px); line-height: .98; }
  .lead { max-width: 900px; margin: 0; color: #383733; font-size: 21px; line-height: 1.55; }
  .thread-meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 32px 0 0; border-top: 1px solid var(--line); }
  .thread-meta div { padding: 15px 18px 0 0; }
  .thread-meta dt, .sidebar span { color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .07em; }
  .thread-meta dd { margin: 5px 0 0; font-weight: 700; }

  .thesis-callout {
    scroll-margin-top: 124px;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 26px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .thesis-callout p {
    max-width: 880px;
    margin: 0;
    color: var(--accent);
    font: 650 21px/1.5 Georgia, 'Times New Roman', serif;
  }
  .thread-section-nav {
    position: sticky;
    top: 72px;
    z-index: 5;
    display: flex;
    gap: 8px 18px;
    overflow-x: auto;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    background: rgba(246, 245, 241, .96);
    backdrop-filter: blur(10px);
    scrollbar-width: none;
  }
  .thread-section-nav::-webkit-scrollbar { display: none; }
  .thread-section-nav a {
    flex: 0 0 auto;
    color: var(--muted);
    font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .05em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .thread-section-nav a:hover, .thread-section-nav a:focus-visible { color: var(--ink); }

  .thread-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 64px; padding-top: 36px; }
  .detail-section, .latest-change { scroll-margin-top: 124px; }
  .detail-section { padding-bottom: 42px; margin-bottom: 42px; border-bottom: 1px solid var(--line); }
  .detail-section h2, .latest-change h2 { margin: 5px 0 13px; font-family: Georgia, 'Times New Roman', serif; font-size: 31px; line-height: 1.12; }
  .detail-section > p { max-width: 820px; color: #34332f; font-size: 18px; line-height: 1.65; }
  .section-intro { color: var(--muted) !important; font-size: 15px !important; }

  .latest-change { margin-bottom: 42px; padding: 28px 30px; border: 1px solid var(--ink); background: var(--panel); }
  .latest-change-head { display: flex; justify-content: space-between; gap: 24px; align-items: start; }
  .latest-change > p { max-width: 850px; margin: 12px 0 0; color: #2f2e2a; font-size: 18px; line-height: 1.65; }
  .latest-stamp { display: grid; gap: 5px; min-width: 132px; color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-align: right; text-transform: uppercase; }
  .latest-stamp span { color: var(--accent); }
  .interpretation-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 24px; border-top: 1px solid var(--line); }
  .interpretation-strip div { min-width: 0; padding: 14px 16px 0 0; }
  .interpretation-strip span { display: block; color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .interpretation-strip strong { display: block; margin-top: 5px; font-size: 13px; text-transform: capitalize; }

  .evidence-map { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .evidence-dimension { min-width: 0; padding: 24px 22px 26px 0; }
  .evidence-dimension + .evidence-dimension { padding-left: 22px; border-left: 1px solid var(--line); }
  .dimension-index { color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .evidence-dimension h3 { margin: 8px 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; line-height: 1.15; }
  .evidence-dimension p { margin: 0; color: #3c3b37; line-height: 1.58; }
  .dimension-links { display: grid; gap: 6px; margin-top: 15px; }
  .dimension-links a { color: var(--accent); font-size: 12px; font-weight: 720; line-height: 1.45; text-underline-offset: 3px; }

  .boundary-list { border-top: 1px solid var(--line); }
  .boundary-item { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 10px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .boundary-item > span { color: var(--accent); font: 800 18px Georgia, 'Times New Roman', serif; }
  .boundary-item p { margin: 0; max-width: 800px; color: #3b3a36; line-height: 1.58; }

  .view-tests { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--line); }
  .view-column { padding: 24px; min-width: 0; }
  .view-column + .view-column { border-left: 1px solid var(--line); }
  .view-heading { display: flex; gap: 10px; align-items: center; color: var(--accent); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
  .view-heading span { font-size: 18px; }
  .view-column ul { margin: 18px 0 0; padding-left: 18px; }
  .view-column li { margin: 0 0 12px; color: #383733; line-height: 1.55; }

  .section-heading-row { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .count { color: var(--muted); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .signal-list article { padding: 20px 0; border-top: 1px solid var(--line); }
  .signal-relation { margin-bottom: 7px; color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .06em; }
  .signal-list a { font-family: Georgia, 'Times New Roman', serif; font-size: 21px; font-weight: 650; text-underline-offset: 4px; }
  .signal-list p { max-width: 780px; margin: 8px 0; color: #3c3b37; line-height: 1.55; }
  .signal-list span { color: var(--muted); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
  .contradicting-list { margin-top: 14px; }
  .empty { color: var(--muted) !important; font-size: 15px !important; }

  .history-intro { margin: 0 0 24px; color: var(--muted) !important; font-size: 15px !important; }
  .timeline { border-top: 1px solid var(--line); }
  .timeline-item { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 14px; padding-top: 24px; }
  .timeline-rail { display: flex; flex-direction: column; align-items: center; }
  .timeline-dot { width: 9px; height: 9px; border: 2px solid var(--ink); border-radius: 50%; background: var(--bg); margin-top: 4px; flex: 0 0 auto; }
  .timeline-line { width: 1px; min-height: 100%; flex: 1 1 auto; background: var(--line); margin-top: 7px; }
  .timeline-body { min-width: 0; padding-bottom: 30px; }
  .timeline-meta { display: flex; flex-wrap: wrap; gap: 10px 16px; color: var(--muted); font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .05em; }
  .timeline-change { max-width: 800px; margin: 9px 0 0; color: #34332f; font-size: 17px; line-height: 1.62; }
  .pattern-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 13px; }
  .pattern-tags span { border: 1px solid var(--line); border-radius: 999px; padding: 5px 8px; color: var(--muted); font: 750 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .04em; }
  .revision-evidence { display: grid; gap: 6px; margin-top: 16px; padding: 13px 15px; background: var(--panel); border-left: 2px solid var(--line); }
  .revision-evidence strong { color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .revision-evidence a { width: fit-content; max-width: 100%; color: var(--accent); font-size: 13px; font-weight: 700; overflow-wrap: anywhere; text-underline-offset: 3px; }

  .sidebar { align-self: start; position: sticky; top: 124px; border-top: 1px solid var(--ink); }
  .sidebar div { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .sidebar span { display: block; margin-bottom: 6px; }
  .sidebar code { display: block; overflow-wrap: anywhere; font: 600 11px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .sidebar strong { color: var(--accent); text-transform: capitalize; }
  .sidebar a { color: var(--accent); font-weight: 700; }

  @media (max-width: 900px) {
    .thread-grid { grid-template-columns: 1fr; gap: 40px; }
    .sidebar { position: static; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .sidebar div { border-bottom: 0; }
    .evidence-map { grid-template-columns: 1fr; }
    .evidence-dimension { padding: 20px 0; }
    .evidence-dimension + .evidence-dimension { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 680px) {
    .thread-header { padding-top: 40px; }
    .status-row { align-items: flex-start; }
    .thread-meta, .sidebar, .view-tests, .interpretation-strip { grid-template-columns: 1fr; }
    .thread-meta { gap: 0; }
    .thesis-callout { grid-template-columns: 1fr; gap: 8px; }
    .thread-section-nav { margin-left: -18px; margin-right: -18px; padding-left: 18px; padding-right: 18px; }
    .section-heading-row, .latest-change-head { align-items: flex-start; flex-direction: column; gap: 8px; }
    .latest-stamp { text-align: left; min-width: 0; }
    .interpretation-strip div { padding-top: 12px; }
    .view-column + .view-column { border-left: 0; border-top: 1px solid var(--line); }
    .latest-change { padding: 22px; }
  }
</style>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import intelligence from '../../data/intelligence.json';
import threadLinks from '../../data/thread-links.json';

const base = import.meta.env.BASE_URL;
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
const threads = [...intelligence.threads].sort((a, b) => b.last_updated.localeCompare(a.last_updated));
---
<BaseLayout
  title="Active threads — GrepSignal"
  description="Persistent GrepSignal theses that connect material signals across time."
>
  <main class="wrap threads-page">
    <header class="page-head">
      <span class="section-kicker">MEMORY</span>
      <h1>Active threads</h1>
      <p>Threads are durable theses, not topic feeds. They change only when reviewed evidence changes the tracked interpretation.</p>
    </header>

    <div class="thread-list">
      {threads.map((thread) => {
        const relation = threadLinks[thread.id as keyof typeof threadLinks];
        const linkedCount = relation ? relation.supporting.length + relation.contradicting.length : thread.signal_count;
        return (
          <article class="thread-row">
            <div class="thread-status">
              <span>{statusMark[thread.status] ?? '·'}</span>
              <strong>{thread.status}</strong>
            </div>
            <div>
              <h2><a href={`${base}threads/${thread.id}/`}>{thread.title}</a></h2>
              <p>{thread.summary}</p>
              {thread.thesis && <p class="thesis"><strong>Current thesis:</strong> {thread.thesis}</p>}
              <div class="meta">{linkedCount} linked signal{linkedCount === 1 ? '' : 's'} · updated {formatDate(thread.last_updated)}</div>
            </div>
            <a class="open-thread" href={`${base}threads/${thread.id}/`}>Open thread →</a>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .threads-page { padding-top: 68px; padding-bottom: 100px; }
  .page-head { max-width: 850px; padding-bottom: 42px; border-bottom: 1px solid var(--ink); }
  .page-head h1 { margin: 8px 0 18px; font-size: clamp(48px, 7vw, 82px); line-height: .98; }
  .page-head p { max-width: 760px; margin: 0; color: #3a3935; font-size: 19px; line-height: 1.6; }
  .thread-list { margin-top: 14px; }
  .thread-row { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 28px; padding: 34px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .thread-status { color: var(--accent); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; }
  .thread-status span { display: block; font-size: 22px; line-height: 1; margin-bottom: 7px; }
  .thread-row h2 { margin: 0 0 10px; font-family: Georgia, 'Times New Roman', serif; font-size: 30px; line-height: 1.12; }
  .thread-row h2 a { color: inherit; text-decoration: none; }
  .thread-row h2 a:hover, .thread-row h2 a:focus-visible { text-decoration: underline; text-underline-offset: 5px; }
  .thread-row p { max-width: 800px; margin: 0; color: #3a3935; line-height: 1.58; }
  .thread-row .thesis { margin-top: 12px; }
  .meta { margin-top: 16px; color: var(--muted); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .open-thread { align-self: center; color: var(--accent); font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace; text-decoration: none; white-space: nowrap; }
  @media (max-width: 760px) {
    .threads-page { padding-top: 44px; }
    .thread-row { grid-template-columns: 1fr; gap: 14px; }
    .thread-status { display: flex; gap: 8px; align-items: center; }
    .thread-status span { margin: 0; font-size: 16px; }
    .open-thread { justify-self: start; }
  }
</style>

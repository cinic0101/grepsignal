---
import BaseLayout from '../../layouts/BaseLayout.astro';
import intelligence from '../../data/intelligence';
import RecordHistory from '../../components/RecordHistory.astro';
import { buildAlternativeHeadline, buildPredictionRetrievalIdentity, buildSearchTitle, jsonLdThings } from '../../data/retrieval';

export function getStaticPaths() {
  return intelligence.predictions.filter(prediction => prediction.first_public_at !== null).map(prediction => ({
    params: { id: prediction.id },
    props: { prediction },
  }));
}

const { prediction } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const relatedThread = intelligence.threads.find(thread => thread.id === prediction.thread_id);
const retrieval = buildPredictionRetrievalIdentity(prediction, relatedThread, intelligence.signals);
const searchTitle = buildSearchTitle(prediction.claim, retrieval);
const probability = Math.round(prediction.initial_probability * 100);
const formatTimestamp = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
  timeZone: 'UTC', timeZoneName: 'short'
}).format(new Date(value));
const predictionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  headline: prediction.claim,
  ...(retrieval.entity_label ? { alternativeHeadline: buildAlternativeHeadline(prediction.claim, retrieval) } : {}),
  description: prediction.claim,
  identifier: prediction.id,
  ...(prediction.first_public_at ? { datePublished: prediction.first_public_at } : {}),
  ...(prediction.last_changed_at ? { dateModified: prediction.last_changed_at } : {}),
  inLanguage: intelligence.canonical_language,
  ...(retrieval.about_entity_names.length ? { about: jsonLdThings(retrieval.about_entity_names) } : {}),
  ...(retrieval.mention_entity_names.length ? { mentions: jsonLdThings(retrieval.mention_entity_names) } : {}),
  mainEntityOfPage: canonicalUrl,
  author: { '@type': 'Organization', name: 'GrepSignal' },
  publisher: { '@type': 'Organization', name: 'GrepSignal' },
};
---
<BaseLayout
  title={searchTitle}
  description={prediction.claim}
  ogType="article"
  publishedAt={prediction.first_public_at ?? undefined}
  jsonLd={predictionJsonLd}
  jsonAlternateHref={`${base}data/predictions/${prediction.id}.json`}
>
  <main class="wrap prediction-detail">
    <a class="back-link" href={`${base}predictions/`}><span aria-hidden="true">←</span> Prediction ledger</a>

    <header class="prediction-header">
      <div class="prediction-title-block">
        <span class="section-kicker">ACCOUNTABILITY / PREDICTION</span>
        {retrieval.entity_label && <p class="entity-subtitle">{retrieval.entity_label}</p>}
        <h1>{relatedThread?.title ?? 'Prediction'}</h1>
        <p class="header-note">A public probabilistic judgment with fixed terms and a scored resolution path.</p>
      </div>
      <div class="probability-card" aria-label={`Initial probability ${probability} percent`}>
        <strong>{probability}%</strong>
        <span>INITIAL PROBABILITY</span>
      </div>
    </header>

    <dl class="prediction-meta">
      <div><dt>Status</dt><dd>{prediction.status}</dd></div>
      <div><dt>Deadline</dt><dd><time datetime={prediction.deadline} title={prediction.deadline}>{formatTimestamp(prediction.deadline)}</time></dd></div>
      <div><dt>Public registration</dt><dd><time datetime={prediction.first_public_at} title={prediction.first_public_at}>{formatTimestamp(prediction.first_public_at)}</time></dd></div>
      <div>
        <dt>Related thread</dt>
        <dd>
          <a href={`${base}threads/${prediction.thread_id}/`}>
            Open current thesis →
          </a>
        </dd>
      </div>
    </dl>

    <div class="prediction-grid">
      <div>
        <section class="prediction-section original-forecast">
          <span class="section-kicker">ORIGINAL FORECAST</span>
          <h2>What was committed</h2>
          <p class="claim-copy">{prediction.claim}</p>
          <p class="accountability-note">
            This claim, its initial probability, deadline, and resolution terms are the original public commitment. They are not rewritten after the outcome is known.
          </p>
        </section>

        {prediction.forecast_basis && (
          <section class="prediction-section forecast-basis">
            <span class="section-kicker">FORECAST BASIS</span>
            <h2>Why {probability}%?</h2>
            <p class="basis-rationale">{prediction.forecast_basis.rationale}</p>

            <div class="basis-grid">
              <article>
                <h3>Evidence pushing the estimate up</h3>
                <ul>
                  {prediction.forecast_basis.supporting_factors.map((factor) => <li>{factor}</li>)}
                </ul>
              </article>
              <article>
                <h3>Why not higher</h3>
                <ul>
                  {prediction.forecast_basis.counter_factors.map((factor) => <li>{factor}</li>)}
                </ul>
              </article>
            </div>

            <div class="basis-method">
              <div>
                <strong>Method</strong>
                <p>{prediction.forecast_basis.method}</p>
              </div>
              <div>
                <strong>Calibration status</strong>
                <p>{prediction.forecast_basis.calibration_note}</p>
              </div>
              <a href={`${base}data/threads/${prediction.thread_id}/versions/${prediction.forecast_basis.thread_snapshot_version}.json`}>
                Thread snapshot v{prediction.forecast_basis.thread_snapshot_version} →
              </a>
            </div>

            <div class="basis-sources">
              <strong>Evidence snapshot at registration</strong>
              <ul>
                {prediction.forecast_basis.evidence.map((source) => (
                  <li><a href={source.url}>{source.publisher}: {source.title}</a></li>
                ))}
              </ul>
            </div>
          </section>
        )}

        <section class="prediction-section forecast-review-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">REVIEW TIMELINE</span>
              <h2>How the evidence moved</h2>
            </div>
            <span class="resolution-count">{prediction.reviews.length} REVIEW{prediction.reviews.length === 1 ? '' : 'S'}</span>
          </div>
          <p class="review-principle">
            Reviews can record supporting, challenging, neutral, or inconclusive evidence. The original {probability}% probability stays fixed by design.
          </p>

          {prediction.reviews.length ? (
            <div class="forecast-review-list">
              {[...prediction.reviews].reverse().map((review) => (
                <article class={`forecast-review forecast-review-${review.assessment}`}>
                  <div class="forecast-review-head">
                    <span class="forecast-review-assessment">{review.assessment.toUpperCase()}</span>
                    <time datetime={review.recorded_at} title={review.recorded_at}>{formatTimestamp(review.recorded_at)}</time>
                  </div>
                  <p class="forecast-review-note">{review.note}</p>

                  <dl class="forecast-review-meta">
                    <div>
                      <dt>Original probability</dt>
                      <dd>{Math.round(review.original_probability * 100)}% — unchanged by design</dd>
                    </div>
                    <div>
                      <dt>Thread snapshot</dt>
                      <dd>
                        <a href={`${base}data/threads/${prediction.thread_id}/versions/${review.thread_snapshot_version}.json`}>
                          v{review.thread_snapshot_version} →
                        </a>
                      </dd>
                    </div>
                    {review.next_review_at && (
                      <div>
                        <dt>Next review</dt>
                        <dd><time datetime={review.next_review_at} title={review.next_review_at}>{formatTimestamp(review.next_review_at)}</time></dd>
                      </div>
                    )}
                  </dl>

                  <div class="forecast-review-checks">
                    <strong>Counterevidence checked</strong>
                    <ul>{review.counterevidence_checked.map((item) => <li>{item}</li>)}</ul>
                  </div>

                  {review.evidence.length > 0 && (
                    <div class="forecast-review-evidence">
                      <strong>Review evidence</strong>
                      <ul>
                        {review.evidence.map((source) => (
                          <li><a href={source.url}>{source.publisher}: {source.title}</a></li>
                        ))}
                      </ul>
                    </div>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-resolution">
              <strong>No forecast review recorded yet.</strong>
              <p>The original probability remains fixed. Material evidence movement can be appended here before the deadline without rewriting the forecast.</p>
            </div>
          )}
        </section>

        <section class="prediction-section">
          <span class="section-kicker">RESOLUTION CONTRACT</span>
          <h2>How this gets resolved</h2>
          <div class="criteria-grid">
            <article>
              <span class="criterion-mark">✓</span>
              <div><strong>Success</strong><p>{prediction.success_criterion}</p></div>
            </article>
            <article>
              <span class="criterion-mark">×</span>
              <div><strong>Failure</strong><p>{prediction.failure_criterion}</p></div>
            </article>
            <article class="insufficient">
              <span class="criterion-mark">?</span>
              <div><strong>Insufficient evidence</strong><p>{prediction.insufficient_evidence_policy}</p></div>
            </article>
          </div>
        </section>

        <section class="prediction-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">TRACK RECORD</span>
              <h2>Resolution history</h2>
            </div>
            <span class="resolution-count">{prediction.resolutions.length} RECORDED</span>
          </div>

          {prediction.resolutions.length ? (
            <div class="resolution-list">
              {prediction.resolutions.map(resolution => (
                <article class="resolution">
                  <div class="resolution-head">
                    <strong>{resolution.outcome}</strong>
                    <span><time datetime={resolution.recorded_at} title={resolution.recorded_at}>{formatTimestamp(resolution.recorded_at)}</time></span>
                  </div>
                  <p>{resolution.note}</p>
                  <div class="resolution-score">Brier score: {resolution.brier_score ?? 'unscored'}</div>
                  {resolution.evidence.length > 0 && (
                    <ul>
                      {resolution.evidence.map(source => (
                        <li><a href={source.url}>{source.publisher}: {source.title}</a></li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-resolution">
              <strong>No eligible resolution recorded yet.</strong>
              <p>Open and unresolved predictions remain visible; the ledger is not scored by selecting only successful outcomes.</p>
            </div>
          )}
        </section>
      </div>

      <aside class="prediction-sidebar">
        <div>
          <span>Prediction ID</span>
          <code>{prediction.id}</code>
        </div>
        <div>
          <span>Initial probability</span>
          <strong>{probability}%</strong>
        </div>
        <div>
          <span>Deadline</span>
          <strong><time datetime={prediction.deadline} title={prediction.deadline}>{formatTimestamp(prediction.deadline)}</time></strong>
        </div>
        <div>
          <span>Context</span>
          <a href={`${base}threads/${prediction.thread_id}/`}>Open related Thread →</a>
        </div>
        <div>
          <span>Machine-readable</span>
          <a href={`${base}data/predictions/${prediction.id}.json`}>Open JSON →</a>
        </div>
      </aside>
    </div>
  </main>

  <RecordHistory />
</BaseLayout>

<style>
  .prediction-detail { padding-top: 30px; padding-bottom: 96px; }
  .back-link {
    display: inline-flex;
    gap: 8px;
    color: var(--muted);
    font: 750 12px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--ink); }

  .prediction-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: 48px;
    align-items: end;
    padding: 34px 0 28px;
    border-bottom: 1px solid var(--ink);
  }
  .prediction-title-block { min-width: 0; }
  .entity-subtitle {
    margin: 10px 0 -2px;
    color: var(--accent);
    font: 800 11px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .05em;
  }
  .prediction-header h1 {
    max-width: 760px;
    margin: 9px 0 0;
    font-size: clamp(42px, 5vw, 62px);
    line-height: .98;
    letter-spacing: -.04em;
  }
  .header-note {
    max-width: 650px;
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .probability-card {
    display: grid;
    gap: 7px;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .probability-card strong {
    color: var(--accent);
    font: 500 58px/1 Georgia, 'Times New Roman', serif;
    letter-spacing: -.04em;
  }
  .probability-card span {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .07em;
  }

  .prediction-meta {
    display: grid;
    grid-template-columns: .7fr 1.1fr 1.1fr 1fr;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .prediction-meta div { min-width: 0; padding: 15px 22px 15px 0; }
  .prediction-meta dt,
  .prediction-sidebar span {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .prediction-meta dd {
    margin: 5px 0 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: capitalize;
  }
  .prediction-meta a { color: var(--accent); text-underline-offset: 3px; }

  .prediction-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 64px;
    padding-top: 30px;
  }
  .prediction-section {
    padding-bottom: 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }
  .prediction-section h2 {
    margin: 5px 0 14px;
    font: 600 29px/1.12 Georgia, 'Times New Roman', serif;
    letter-spacing: -.02em;
  }
  .original-forecast { padding-top: 0; }
  .claim-copy {
    max-width: 840px;
    margin: 0;
    color: #2f2e2a;
    font: 500 20px/1.52 Georgia, 'Times New Roman', serif;
    letter-spacing: -.005em;
  }
  .accountability-note {
    max-width: 760px;
    margin: 13px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .basis-rationale {
    max-width: 820px;
    margin: 0 0 22px;
    color: #34322e;
    font-size: 16px;
    line-height: 1.62;
  }
  .basis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    border-top: 1px solid var(--ink);
  }
  .basis-grid article { padding: 20px 0 8px; }
  .basis-grid h3 {
    margin: 0 0 10px;
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .basis-grid ul,
  .basis-sources ul { margin: 0; padding-left: 20px; }
  .basis-grid li,
  .basis-sources li { line-height: 1.58; }
  .basis-grid li + li,
  .basis-sources li + li { margin-top: 8px; }
  .basis-method {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 20px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .basis-method strong,
  .basis-sources > strong {
    display: block;
    margin-bottom: 6px;
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .basis-method p { margin: 0; color: #45433e; font-size: 13px; line-height: 1.58; }
  .basis-method > a {
    grid-column: 1 / -1;
    justify-self: start;
    color: var(--accent);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    text-decoration: none;
  }
  .basis-method > a:hover,
  .basis-method > a:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
  .basis-sources { margin-top: 20px; }
  .basis-sources a { color: var(--accent); text-underline-offset: 3px; }

  .review-principle {
    max-width: 800px;
    margin: -4px 0 18px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .forecast-review-list { border-top: 1px solid var(--ink); }
  .forecast-review {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .forecast-review-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
  }
  .forecast-review-assessment {
    color: var(--accent);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .06em;
  }
  .forecast-review-challenging .forecast-review-assessment { color: var(--accent-warm); }
  .forecast-review-neutral .forecast-review-assessment,
  .forecast-review-inconclusive .forecast-review-assessment { color: var(--muted); }
  .forecast-review-head time {
    color: var(--muted);
    font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .forecast-review-note {
    max-width: 820px;
    margin: 10px 0 16px;
    color: #35332f;
    font-size: 15px;
    line-height: 1.62;
  }
  .forecast-review-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0 0 16px;
  }
  .forecast-review-meta div { min-width: 0; }
  .forecast-review-meta dt,
  .forecast-review-checks > strong,
  .forecast-review-evidence > strong {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .055em;
    text-transform: uppercase;
  }
  .forecast-review-meta dd { margin: 5px 0 0; color: #3d3b36; font-size: 13px; font-weight: 700; }
  .forecast-review-meta a,
  .forecast-review-evidence a { color: var(--accent); text-underline-offset: 3px; }
  .forecast-review-checks,
  .forecast-review-evidence {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .forecast-review-checks ul,
  .forecast-review-evidence ul { margin: 8px 0 0; padding-left: 20px; }
  .forecast-review-checks li,
  .forecast-review-evidence li { line-height: 1.58; }
  .forecast-review-checks li + li,
  .forecast-review-evidence li + li { margin-top: 7px; }

  .criteria-grid { display: grid; border-top: 1px solid var(--ink); }
  .criteria-grid article {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .criterion-mark { color: var(--accent); font: 600 24px/1 Georgia, serif; }
  .criteria-grid strong { display: block; margin-bottom: 6px; font-size: 14px; }
  .criteria-grid p { max-width: 800px; margin: 0; color: #3b3a36; line-height: 1.62; }
  .criteria-grid .insufficient .criterion-mark { color: var(--accent-warm); }

  .section-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .resolution-count {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .06em;
  }
  .resolution-list { border-top: 1px solid var(--ink); }
  .resolution { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .resolution-head { display: flex; justify-content: space-between; gap: 20px; align-items: baseline; }
  .resolution-head strong { color: var(--accent); text-transform: uppercase; }
  .resolution-head span,
  .resolution-score {
    color: var(--muted);
    font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .resolution p { max-width: 800px; margin: 10px 0; line-height: 1.62; }
  .resolution ul { margin: 14px 0 0; padding-left: 20px; }
  .resolution li + li { margin-top: 7px; }
  .resolution a { color: var(--accent); text-underline-offset: 3px; }
  .empty-resolution { padding: 24px; border: 1px solid var(--line); background: var(--panel); }
  .empty-resolution strong { font: 600 20px Georgia, serif; }
  .empty-resolution p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .prediction-sidebar {
    position: sticky;
    top: 104px;
    align-self: start;
    border-top: 1px solid var(--ink);
  }
  .prediction-sidebar div { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .prediction-sidebar span { display: block; margin-bottom: 6px; }
  .prediction-sidebar code {
    display: block;
    overflow-wrap: anywhere;
    font: 600 12px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .prediction-sidebar strong { color: var(--accent); text-transform: capitalize; }
  .prediction-sidebar a { color: var(--accent); font-weight: 700; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .prediction-header { grid-template-columns: 1fr; gap: 22px; }
    .probability-card {
      padding: 18px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .prediction-meta { grid-template-columns: 1fr 1fr; }
    .prediction-grid { grid-template-columns: 1fr; gap: 38px; }
    .prediction-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .prediction-sidebar div { border-bottom: 0; }
  }
  @media (max-width: 620px) {
    .prediction-header { padding-top: 28px; }
    .prediction-header h1 { font-size: 40px; }
    .probability-card strong { font-size: 52px; }
    .prediction-meta,
    .prediction-sidebar { grid-template-columns: 1fr; }
    .prediction-grid { padding-top: 24px; }
    .claim-copy { font-size: 19px; }
    .basis-grid,
    .basis-method,
    .forecast-review-meta { grid-template-columns: 1fr; gap: 12px; }
    .forecast-review-head { align-items: flex-start; flex-direction: column; gap: 6px; }
    .section-heading-row { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>

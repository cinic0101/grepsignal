---
import BaseLayout from '../../layouts/BaseLayout.astro';
import intelligence from '../../data/intelligence';

export function getStaticPaths() {
  return intelligence.predictions.map(prediction => ({
    params: { id: prediction.id },
    props: { prediction },
  }));
}

const { prediction } = Astro.props;
const base = import.meta.env.BASE_URL;
const relatedThread = intelligence.threads.find(thread => thread.id === prediction.thread_id);
const probability = Math.round(prediction.initial_probability * 100);
---
<BaseLayout title={`${prediction.claim} — GrepSignal prediction`} description={prediction.claim}>
  <main class="wrap prediction-detail">
    <a class="back-link" href={`${base}#predictions`}><span aria-hidden="true">←</span> Prediction ledger</a>

    <header class="prediction-header">
      <div>
        <span class="section-kicker">ACCOUNTABILITY / PREDICTION</span>
        <h1>{prediction.claim}</h1>
      </div>
      <div class="probability-card" aria-label={`Initial probability ${probability} percent`}>
        <strong>{probability}%</strong>
        <span>INITIAL PROBABILITY</span>
      </div>
    </header>

    <dl class="prediction-meta">
      <div><dt>Status</dt><dd>{prediction.status}</dd></div>
      <div><dt>Lifecycle</dt><dd>{prediction.lifecycle}</dd></div>
      <div><dt>Deadline</dt><dd>{prediction.deadline}</dd></div>
      <div>
        <dt>Related thread</dt>
        <dd>
          <a href={`${base}threads/${prediction.thread_id}/`}>
            {relatedThread?.title ?? prediction.thread_id}
          </a>
        </dd>
      </div>
    </dl>

    <div class="prediction-grid">
      <div>
        <section class="prediction-section">
          <span class="section-kicker">COMMITMENT</span>
          <h2>What we are predicting</h2>
          <p class="claim-copy">{prediction.claim}</p>
          <p class="accountability-note">
            The probability and resolution terms below are the original public commitment. They should not be rewritten after the outcome is known.
          </p>
        </section>

        <section class="prediction-section">
          <span class="section-kicker">RESOLUTION CONTRACT</span>
          <h2>How this gets resolved</h2>
          <div class="criteria-grid">
            <article>
              <span class="criterion-mark">✓</span>
              <div><strong>Success</strong><p>{prediction.success_criterion}</p></div>
            </article>
            <article>
              <span class="criterion-mark">×</span>
              <div><strong>Failure</strong><p>{prediction.failure_criterion}</p></div>
            </article>
            <article class="insufficient">
              <span class="criterion-mark">?</span>
              <div><strong>Insufficient evidence</strong><p>{prediction.insufficient_evidence_policy}</p></div>
            </article>
          </div>
        </section>

        <section class="prediction-section">
          <div class="section-heading-row">
            <div>
              <span class="section-kicker">TRACK RECORD</span>
              <h2>Resolution history</h2>
            </div>
            <span class="resolution-count">{prediction.resolutions.length} RECORDED</span>
          </div>

          {prediction.resolutions.length ? (
            <div class="resolution-list">
              {prediction.resolutions.map(resolution => (
                <article class="resolution">
                  <div class="resolution-head">
                    <strong>{resolution.outcome}</strong>
                    <span>{resolution.recorded_at}</span>
                  </div>
                  <p>{resolution.note}</p>
                  <div class="resolution-score">Brier score: {resolution.brier_score ?? 'unscored'}</div>
                  {resolution.evidence.length > 0 && (
                    <ul>
                      {resolution.evidence.map(source => (
                        <li><a href={source.url}>{source.publisher}: {source.title}</a></li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-resolution">
              <strong>No eligible resolution recorded yet.</strong>
              <p>Open and unresolved predictions remain visible; the ledger is not scored by selecting only successful outcomes.</p>
            </div>
          )}
        </section>
      </div>

      <aside class="prediction-sidebar">
        <div>
          <span>Prediction ID</span>
          <code>{prediction.id}</code>
        </div>
        <div>
          <span>Initial probability</span>
          <strong>{probability}%</strong>
        </div>
        <div>
          <span>Deadline</span>
          <strong>{prediction.deadline}</strong>
        </div>
        <div>
          <span>Context</span>
          <a href={`${base}threads/${prediction.thread_id}/`}>Open related Thread →</a>
        </div>
        <div>
          <span>Machine-readable</span>
          <a href={`${base}data/intelligence.json`}>Open JSON →</a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .prediction-detail { padding-top: 34px; padding-bottom: 96px; }
  .back-link {
    display: inline-flex;
    gap: 8px;
    color: var(--muted);
    font: 750 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--ink); }
  .prediction-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 54px;
    align-items: end;
    padding: 54px 0 36px;
    border-bottom: 1px solid var(--ink);
  }
  .prediction-header h1 {
    max-width: 900px;
    margin: 12px 0 0;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 1;
  }
  .probability-card {
    display: grid;
    gap: 8px;
    padding-left: 26px;
    border-left: 1px solid var(--line);
  }
  .probability-card strong {
    font: 500 68px/1 Georgia, 'Times New Roman', serif;
    color: var(--accent);
    letter-spacing: -.04em;
  }
  .probability-card span {
    color: var(--muted);
    font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .07em;
  }
  .prediction-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .prediction-meta div { min-width: 0; padding: 17px 20px 17px 0; }
  .prediction-meta dt,
  .prediction-sidebar span {
    color: var(--muted);
    font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .prediction-meta dd { margin: 5px 0 0; font-size: 13px; font-weight: 700; text-transform: capitalize; }
  .prediction-meta a { color: var(--accent); text-underline-offset: 3px; }

  .prediction-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 64px;
    padding-top: 46px;
  }
  .prediction-section { padding-bottom: 40px; margin-bottom: 40px; border-bottom: 1px solid var(--line); }
  .prediction-section h2 { margin: 5px 0 15px; font: 600 31px/1.12 Georgia, 'Times New Roman', serif; letter-spacing: -.02em; }
  .claim-copy { max-width: 820px; margin: 0; color: #2f2e2a; font: 600 22px/1.48 Georgia, 'Times New Roman', serif; }
  .accountability-note { max-width: 760px; margin: 14px 0 0; color: var(--muted); font-size: 13px; line-height: 1.6; }

  .criteria-grid { display: grid; border-top: 1px solid var(--ink); }
  .criteria-grid article {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .criterion-mark { color: var(--accent); font: 600 24px/1 Georgia, serif; }
  .criteria-grid strong { display: block; margin-bottom: 6px; font-size: 14px; }
  .criteria-grid p { max-width: 800px; margin: 0; color: #3b3a36; line-height: 1.62; }
  .criteria-grid .insufficient .criterion-mark { color: var(--accent-warm); }

  .section-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .resolution-count { color: var(--muted); font: 800 9px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .06em; }
  .resolution-list { border-top: 1px solid var(--ink); }
  .resolution { padding: 22px 0; border-bottom: 1px solid var(--line); }
  .resolution-head { display: flex; justify-content: space-between; gap: 20px; align-items: baseline; }
  .resolution-head strong { color: var(--accent); text-transform: uppercase; }
  .resolution-head span, .resolution-score { color: var(--muted); font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .resolution p { max-width: 800px; margin: 10px 0; line-height: 1.62; }
  .resolution ul { margin: 14px 0 0; padding-left: 20px; }
  .resolution li + li { margin-top: 7px; }
  .resolution a { color: var(--accent); text-underline-offset: 3px; }
  .empty-resolution { padding: 24px; border: 1px solid var(--line); background: var(--panel); }
  .empty-resolution strong { font: 600 20px Georgia, serif; }
  .empty-resolution p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }

  .prediction-sidebar { position: sticky; top: 104px; align-self: start; border-top: 1px solid var(--ink); }
  .prediction-sidebar div { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .prediction-sidebar span { display: block; margin-bottom: 6px; }
  .prediction-sidebar code { display: block; overflow-wrap: anywhere; font: 600 11px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .prediction-sidebar strong { color: var(--accent); text-transform: capitalize; }
  .prediction-sidebar a { color: var(--accent); font-weight: 700; text-underline-offset: 3px; }

  @media (max-width: 900px) {
    .prediction-header { grid-template-columns: 1fr; gap: 28px; }
    .probability-card { padding: 20px 0 0; border-left: 0; border-top: 1px solid var(--line); }
    .prediction-meta { grid-template-columns: 1fr 1fr; }
    .prediction-grid { grid-template-columns: 1fr; gap: 40px; }
    .prediction-sidebar { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .prediction-sidebar div { border-bottom: 0; }
  }
  @media (max-width: 620px) {
    .prediction-header { padding-top: 40px; }
    .prediction-header h1 { font-size: 43px; }
    .probability-card strong { font-size: 58px; }
    .prediction-meta, .prediction-sidebar { grid-template-columns: 1fr; }
    .section-heading-row { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>

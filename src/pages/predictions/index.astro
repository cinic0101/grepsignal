---
import BaseLayout from '../../layouts/BaseLayout.astro';
import intelligence from '../../data/intelligence';

const base = import.meta.env.BASE_URL;
const predictions = [...intelligence.predictions]
  .filter((prediction) => prediction.first_public_at !== null)
  .sort((a, b) => a.deadline.localeCompare(b.deadline));
const formatTimestamp = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(value));
const relatedThread = (threadId: string) =>
  intelligence.threads.find((thread) => thread.id === threadId);
---
<BaseLayout
  title="Prediction ledger — GrepSignal"
  description="Public, immutable GrepSignal forecasts with fixed probabilities, deadlines, and resolution contracts."
>
  <main class="wrap prediction-ledger-page">
    <header class="page-head">
      <span class="section-kicker">ACCOUNTABILITY</span>
      <h1>Prediction ledger</h1>
      <p>
        Forecasts derived from active Threads. Probability, deadline, and resolution terms are fixed at public registration; outcomes remain visible whether correct, incorrect, or unresolved.
      </p>
      <p class="method-note">
        Probabilities are structured editorial judgments, rounded to five-point increments. GrepSignal does not claim statistical calibration yet; each forecast records the evidence and counter-factors behind its original estimate.
      </p>
    </header>

    <section class="ledger-summary" aria-label="Prediction ledger summary">
      <div><strong>{predictions.length}</strong><span>PUBLIC FORECASTS</span></div>
      <div><strong>{predictions.filter((prediction) => prediction.status === 'open').length}</strong><span>OPEN</span></div>
      <div><strong>{predictions.filter((prediction) => prediction.status === 'resolved').length}</strong><span>RESOLVED</span></div>
    </section>

    <section class="prediction-list" aria-label="Public predictions">
      {predictions.map((prediction, index) => {
        const probability = Math.round(prediction.initial_probability * 100);
        const thread = relatedThread(prediction.thread_id);
        return (
          <article class="prediction-row">
            <div class="prediction-index">{String(index + 1).padStart(2, '0')}</div>
            <div class="probability-column">
              <strong>{probability}%</strong>
              <span>INITIAL</span>
            </div>
            <div class="prediction-copy">
              <div class="prediction-meta">
                <span>{prediction.status.toUpperCase()}</span>
                <span>DEADLINE {formatTimestamp(prediction.deadline).toUpperCase()}</span>
                {prediction.reviews.length > 0 && (
                  <span>
                    {prediction.reviews.length} REVIEW{prediction.reviews.length === 1 ? '' : 'S'} · LAST {formatTimestamp(prediction.reviews.at(-1).recorded_at).toUpperCase()}
                  </span>
                )}
              </div>
              <h2>
                <a href={base + 'predictions/' + prediction.id + '/'}>
                  {thread?.title ?? prediction.thread_id}
                </a>
              </h2>
              <p class="prediction-claim">{prediction.claim}</p>
              <div class="prediction-context">
                <span>Derived from</span>
                <a href={base + 'threads/' + prediction.thread_id + '/'}>{thread?.title ?? prediction.thread_id}</a>
              </div>
            </div>
            <a class="open-prediction" href={base + 'predictions/' + prediction.id + '/'}>Open forecast →</a>
          </article>
        );
      })}
    </section>
  </main>
</BaseLayout>

<style>
  .prediction-ledger-page { padding-top: 68px; padding-bottom: 100px; }
  .page-head { max-width: 880px; padding-bottom: 42px; border-bottom: 1px solid var(--ink); }
  .page-head h1 { margin: 8px 0 18px; font-size: clamp(48px, 7vw, 82px); line-height: .98; }
  .page-head p { margin: 0; max-width: 800px; color: #3a3935; font-size: 19px; line-height: 1.6; }
  .page-head .method-note { margin-top: 14px; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .ledger-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--ink);
  }
  .ledger-summary div { display: grid; gap: 6px; padding: 24px 0; }
  .ledger-summary strong {
    color: var(--accent);
    font: 600 34px/1 Georgia, 'Times New Roman', serif;
  }
  .ledger-summary span {
    color: var(--muted);
    font: 800 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .06em;
  }
  .prediction-row {
    display: grid;
    grid-template-columns: 44px 92px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }
  .prediction-index {
    padding-top: 7px;
    color: var(--muted);
    font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .probability-column {
    display: grid;
    gap: 5px;
    padding-top: 2px;
  }
  .probability-column strong {
    color: var(--accent);
    font: 600 38px/1 Georgia, 'Times New Roman', serif;
    letter-spacing: -.04em;
  }
  .probability-column span,
  .prediction-meta,
  .prediction-context span {
    color: var(--muted);
    font: 800 10px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .05em;
  }
  .prediction-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-bottom: 7px;
  }
  .prediction-copy h2 {
    margin: 0 0 10px;
    font: 600 29px/1.12 Georgia, 'Times New Roman', serif;
    letter-spacing: -.02em;
  }
  .prediction-copy h2 a { color: inherit; text-decoration: none; }
  .prediction-copy h2 a:hover,
  .prediction-copy h2 a:focus-visible { text-decoration: underline; text-underline-offset: 5px; }
  .prediction-claim {
    display: -webkit-box;
    max-width: 880px;
    margin: 0;
    overflow: hidden;
    color: #44423d;
    font-size: 15px;
    line-height: 1.58;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  .prediction-context {
    display: flex;
    gap: 7px;
    align-items: baseline;
    margin-top: 12px;
    font-size: 12px;
  }
  .prediction-context a { color: var(--accent); text-underline-offset: 3px; }
  .open-prediction {
    align-self: center;
    color: var(--accent);
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    text-decoration: none;
    white-space: nowrap;
  }
  .open-prediction:hover,
  .open-prediction:focus-visible { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 860px) {
    .prediction-row {
      grid-template-columns: 72px minmax(0, 1fr) auto;
      gap: 18px;
    }
    .prediction-index { display: none; }
    .probability-column strong { font-size: 32px; }
  }
  @media (max-width: 620px) {
    .prediction-ledger-page { padding-top: 44px; }
    .ledger-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ledger-summary strong { font-size: 29px; }
    .prediction-row {
      grid-template-columns: 62px minmax(0, 1fr);
      gap: 14px;
    }
    .open-prediction { grid-column: 2; justify-self: start; }
    .prediction-copy h2 { font-size: 24px; }
    .prediction-claim { -webkit-line-clamp: 4; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import intelligence from '../data/intelligence.json';

const base = import.meta.env.BASE_URL;
const typeLabels: Record<string, string> = {
  platform_shift: 'PLATFORM SHIFT',
  capability_delta: 'CAPABILITY DELTA',
  cost_intelligence: 'COST / INTELLIGENCE',
  ecosystem_momentum: 'ECOSYSTEM MOMENTUM',
  second_order_effect: 'SECOND-ORDER EFFECT',
};
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
};
const updated = new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(intelligence.generated_at));
---
<BaseLayout>
  <section class="preview-notice" role="note">
    <div class="wrap">
      <strong>PREVIEW DATA</strong>
      <span>{intelligence.notice}</span>
    </div>
  </section>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">&gt; grep --signal ai-era</div>
        <h1>Grep the noise.<br />Find the signal.</h1>
        <p>
          Structured intelligence on the changes shaping the AI era — connected across time,
          pushed into second-order effects, and tested through falsifiable predictions.
        </p>
      </div>
      <div class="hero-meta" aria-label="Preview statistics">
        <div class="meta-row"><span>Preview date</span><strong>{updated}</strong></div>
        <div class="meta-row"><span>Material signals</span><strong>{intelligence.stats.material_signals}</strong></div>
        <div class="meta-row"><span>Active threads</span><strong>{intelligence.stats.active_threads}</strong></div>
        <div class="meta-row"><span>Open predictions</span><strong>{intelligence.stats.open_predictions}</strong></div>
        <div class="meta-row"><span>Language</span><strong>{intelligence.canonical_language.toUpperCase()}</strong></div>
      </div>
    </div>
  </section>

  <main class="wrap main-content">
    <section id="signals">
      <div class="section-head">
        <div>
          <span class="section-kicker">INTELLIGENCE</span>
          <h2>Today’s signals</h2>
        </div>
        <small>Only material changes should be published.</small>
      </div>

      <div class="signal-list">
        {intelligence.signals.length === 0 ? (
          <div class="empty-state">No material signal today.</div>
        ) : intelligence.signals.map((signal, index) => (
          <article class="signal" id={signal.id}>
            <div class="index">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <div class="tagrow">
                <span class="tag">{typeLabels[signal.type] ?? signal.type.toUpperCase()}</span>
                <span class={`status status-${signal.status}`}>
                  {statusMark[signal.status] ?? '·'} {signal.status.toUpperCase()}
                </span>
              </div>
              <h3>{signal.title}</h3>
              <p class="summary">{signal.summary}</p>
              <div class="source-line">
                {signal.source_count} sources · {signal.independent_source_count} independent · first observed {signal.first_observed}
              </div>
            </div>
            <aside class="signal-aside">
              <div><span class="label">Why it matters</span>{signal.why_it_matters}</div>
              <div><span class="label">Second-order</span><span class="arrow">{signal.second_order_effect}</span></div>
              <div><span class="label">Watch next</span>{signal.watch_next}</div>
            </aside>
          </article>
        ))}
      </div>
    </section>

    <section class="grid-sections">
      <div class="card" id="threads">
        <div class="cardtop">
          <div>
            <span class="section-kicker">MEMORY</span>
            <h2>Active threads</h2>
          </div>
          <span class="beta">{intelligence.threads.length} ACTIVE</span>
        </div>
        {intelligence.threads.map((thread) => (
          <article class="thread">
            <div>
              <h3>{thread.title}</h3>
              <p>{thread.summary}</p>
            </div>
            <div class="thread-stat">
              {statusMark[thread.status] ?? '·'} {thread.status}<br />{thread.signal_count} signals
            </div>
          </article>
        ))}
      </div>

      <div class="card" id="predictions">
        <div class="cardtop">
          <div>
            <span class="section-kicker">ACCOUNTABILITY</span>
            <h2>Prediction ledger</h2>
          </div>
          <span class="beta">PREVIEW</span>
        </div>
        {intelligence.predictions.map((prediction) => (
          <article class="prediction">
            <span class="label">Open · deadline {prediction.deadline}</span>
            <h3>{prediction.claim}</h3>
            <div class="probability-row">
              <span class="delta">
                {Math.round(prediction.previous_probability * 100)}% → {Math.round(prediction.probability * 100)}%
              </span>
              <div class="bar" aria-label={`Probability ${Math.round(prediction.probability * 100)} percent`}>
                <span style={`width:${Math.round(prediction.probability * 100)}%`}></span>
              </div>
            </div>
            <p class="muted">{prediction.update_reason}</p>
          </article>
        ))}
        <div class="verification-note">
          <span class="verify-mark">✓</span>
          <div><strong>Score what we predicted, including misses.</strong><br /><span class="muted">Confirmed · Partial · Falsified · Unresolved</span></div>
        </div>
      </div>
    </section>

    <section class="agent-panel" id="agents">
      <div>
        <span class="section-kicker">MACHINE-READABLE</span>
        <code>
          &gt; grep signal --topic coding-agents --since 7d<br />
          source: structured public intelligence
        </code>
      </div>
      <div class="agent-links">
        <a href={`${base}data/intelligence.json`}>JSON</a>
        <a href={`${base}schema/intelligence.schema.json`}>SCHEMA</a>
        <a href="https://github.com/cinic0101/grepsignal">GITHUB</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footerline">
      <span>GrepSignal — structured intelligence for humans and agents.</span>
      <span>Link to evidence. Don’t mirror it.</span>
    </div>
  </footer>
</BaseLayout>

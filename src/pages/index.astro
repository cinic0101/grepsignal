---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoveragePanel from '../components/CoveragePanel.astro';
import intelligence from '../data/intelligence.json';

const base = import.meta.env.BASE_URL;
const isPublished = intelligence.publication_status === 'published';
const typeLabels: Record<string, string> = {
  platform_shift: 'PLATFORM SHIFT',
  capability_delta: 'CAPABILITY DELTA',
  cost_intelligence: 'COST / INTELLIGENCE',
  ecosystem_momentum: 'ECOSYSTEM MOMENTUM',
  second_order_effect: 'SECOND-ORDER EFFECT',
};
const statusMark: Record<string, string> = {
  strengthening: '↑',
  emerging: '↑',
  stable: '→',
  weakening: '↓',
};
const updated = new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(intelligence.generated_at));
const formatMonth = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', timeZone: 'UTC' })
    .format(new Date(Date.UTC(year, month - 1, 1)));
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC'
}).format(new Date(`${value}T00:00:00Z`));
---
<BaseLayout>
  <section class={`preview-notice ${isPublished ? 'live-notice' : ''}`} role="note">
    <div class="wrap">
      <strong>{isPublished ? 'LIVE INTELLIGENCE' : 'PREVIEW DATA'}</strong>
      <span>{intelligence.notice}</span>
    </div>
  </section>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">&gt; grep --signal ai-era</div>
        <h1>Grep the noise.<br />Find the signal.</h1>
        <p>
          Structured intelligence on the changes shaping the AI era — connected across time,
          pushed into second-order effects, and tested through falsifiable predictions.
        </p>
      </div>
      <div class="hero-meta" aria-label="Publication statistics">
        <div class="meta-row"><span>{isPublished ? 'Published' : 'Preview date'}</span><strong>{updated}</strong></div>
        <div class="meta-row"><span>Material signals</span><strong>{intelligence.stats.material_signals}</strong></div>
        <div class="meta-row"><span>Active threads</span><strong>{intelligence.stats.active_threads}</strong></div>
        <div class="meta-row"><span>Open predictions</span><strong>{intelligence.stats.open_predictions}</strong></div>
        <div class="meta-row"><span>Language</span><strong>{intelligence.canonical_language.toUpperCase()}</strong></div>
      </div>
    </div>
  </section>

  <main class="wrap main-content">
    <section id="signals">
      <div class="section-head">
        <div>
          <span class="section-kicker">INTELLIGENCE</span>
          <h2>Latest signals</h2>
        </div>
        <small>Only material changes are published.</small>
      </div>

      <div class="signal-list">
        {intelligence.signals.length === 0 ? (
          <div class="empty-state">No published signal in this dataset.</div>
        ) : intelligence.signals.map((signal, index) => (
          <article class="signal" id={signal.id}>
            <div class="index">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <div class="tagrow">
                <span class="tag">{typeLabels[signal.type] ?? signal.type.toUpperCase()}</span>
                <span class={`status status-${signal.status}`}>
                  {statusMark[signal.status] ?? '·'} {signal.status.toUpperCase()}
                </span>
              </div>
              <h3>
                <a class="signal-title-link" href={`${base}signals/${signal.id}/`}>{signal.title}</a>
              </h3>
              <p class="summary">{signal.summary}</p>
              <div class="source-line">
                {signal.source_count} linked sources · {signal.source_organization_count} source organizations · registered {formatDate(signal.registered_at)} · evidence since {formatMonth(signal.evidence_since)}
              </div>
              <a class="signal-link" href={`${base}signals/${signal.id}/`}>
                View signal <span aria-hidden="true">→</span>
              </a>
            </div>
            <aside class="signal-aside">
              <div><span class="label">Why it matters</span>{signal.why_it_matters}</div>
              <div><span class="label">Second-order</span><span class="arrow">{signal.second_order_effect}</span></div>
              <div><span class="label">Watch next</span>{signal.watch_next}</div>
            </aside>
          </article>
        ))}
      </div>
    </section>

    <CoveragePanel />

    <section class="grid-sections">
      <div class="card" id="threads">
        <div class="cardtop">
          <div>
            <span class="section-kicker">MEMORY</span>
            <h2>Active threads</h2>
          </div>
          <span class="beta">{intelligence.threads.length} ACTIVE</span>
        </div>
        {intelligence.threads.length === 0 ? (
          <div class="empty-card">No active thread yet.</div>
        ) : intelligence.threads.map((thread) => (
          <article class="thread">
            <div>
              <h3>{thread.title}</h3>
              <p>{thread.summary}</p>
              {thread.thesis && <p class="thread-thesis"><strong>Thesis:</strong> {thread.thesis}</p>}
            </div>
            <div class="thread-stat">
              {statusMark[thread.status] ?? '·'} {thread.status}<br />{thread.signal_count} signal{thread.signal_count === 1 ? '' : 's'}
            </div>
          </article>
        ))}
      </div>

      <div class="card" id="predictions">
        <div class="cardtop">
          <div>
            <span class="section-kicker">ACCOUNTABILITY</span>
            <h2>Prediction ledger</h2>
          </div>
          <span class="beta">{intelligence.predictions.length} OPEN</span>
        </div>
        {intelligence.predictions.length === 0 ? (
          <div class="empty-card">
            <strong>No formal prediction in this cycle.</strong>
            <p>GrepSignal does not force a forecast when the resolution criteria are not mature enough.</p>
          </div>
        ) : intelligence.predictions.map((prediction) => (
          <article class="prediction">
            <span class="label">Open · deadline {prediction.deadline}</span>
            <h3>{prediction.claim}</h3>
            <div class="probability-row">
              <span class="delta">{Math.round(prediction.probability * 100)}%</span>
              <div class="bar" aria-label={`Probability ${Math.round(prediction.probability * 100)} percent`}>
                <span style={`width:${Math.round(prediction.probability * 100)}%`}></span>
              </div>
            </div>
          </article>
        ))}
        <div class="verification-note">
          <span class="verify-mark">✓</span>
          <div><strong>Score what we predicted, including misses.</strong><br /><span class="muted">Confirmed · Partial · Falsified · Unresolved</span></div>
        </div>
      </div>
    </section>

    <section class="agent-panel" id="agents">
      <div>
        <span class="section-kicker">MACHINE-READABLE</span>
        <code>
          &gt; grep signal --since 7d<br />
          source: structured public intelligence
        </code>
      </div>
      <div class="agent-links">
        <a href={`${base}data/intelligence.json`}>JSON</a>
        <a href={`${base}data/coverage.json`}>COVERAGE</a>
        <a href={`${base}schema/intelligence.schema.json`}>SCHEMA</a>
        <a href={`${base}schema/coverage.schema.json`}>COVERAGE SCHEMA</a>
        <a href="https://github.com/cinic0101/grepsignal">GITHUB</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footerline">
      <span>GrepSignal — structured intelligence for humans and agents.</span>
      <span>Link to evidence. Don’t mirror it.</span>
    </div>
  </footer>
</BaseLayout>

<style>
  .live-notice strong { color: var(--accent); }
  .signal-title-link { text-decoration: none; }
  .signal-title-link:hover, .signal-title-link:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .signal-link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    margin-top: 14px;
    color: var(--accent);
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: .04em;
    text-decoration: none;
  }
  .signal-link:hover, .signal-link:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
  .thread-thesis { margin-top: 10px !important; color: #3d3b36 !important; }
  .empty-card { border-top: 1px solid var(--line); padding: 22px 0 8px; color: var(--muted); }
  .empty-card strong { color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: 20px; font-weight: 600; }
  .empty-card p { margin: 7px 0 0; font-size: 13px; }
</style>

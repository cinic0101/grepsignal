---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'GrepSignal — grep the noise, find the signal.',
  description = 'Structured AI-era intelligence: signals, second-order effects, predictions, and verification.',
  robots = 'index,follow',
  ogType = 'website',
  publishedAt,
  jsonLd,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const intelligenceJsonUrl = new URL(`${base}data/intelligence.json`, Astro.site ?? Astro.url.origin).toString();
const structuredData = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="9JVhmQsKWo9P-g9ECIWEmPjv1yJIrVs3RIGYvU-USdk" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/json" title="GrepSignal intelligence JSON" href={intelligenceJsonUrl} />
    <meta property="og:site_name" content="GrepSignal" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={base} aria-label="GrepSignal home">
          <span class="mark" aria-hidden="true">&gt;_</span>
          <span>GrepSignal</span>
          <span class="beta">BETA</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={`${base}#signals`}>Signals</a>
          <a href={`${base}#threads`}>Threads</a>
          <a href={`${base}#predictions`}>Predictions</a>
          <a href={`${base}agents/`}>For agents</a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>

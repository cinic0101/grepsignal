---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GrepSignal — grep the noise, find the signal.',
  description = 'Structured AI-era intelligence: signals, second-order effects, predictions, and verification.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={base} aria-label="GrepSignal home">
          <span class="mark" aria-hidden="true">&gt;_</span>
          <span>GrepSignal</span>
          <span class="beta">BETA</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="#signals">Signals</a>
          <a href="#threads">Threads</a>
          <a href="#predictions">Predictions</a>
          <a href="#agents">For agents</a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>

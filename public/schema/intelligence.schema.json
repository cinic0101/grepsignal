{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinic0101.github.io/grepsignal/schema/intelligence.schema.json",
  "title": "GrepSignal public intelligence envelope",
  "type": "object",
  "required": [
    "schema_version",
    "publication_status",
    "canonical_language",
    "generated_at",
    "stats",
    "signals",
    "threads",
    "predictions",
    "content_license",
    "accountability"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "publication_status": {
      "enum": [
        "preview_sample",
        "published"
      ]
    },
    "canonical_language": {
      "const": "en"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notice": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "required": [
        "material_signals",
        "active_threads",
        "open_predictions"
      ],
      "properties": {
        "material_signals": {
          "type": "integer",
          "minimum": 0
        },
        "active_threads": {
          "type": "integer",
          "minimum": 0
        },
        "open_predictions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "title",
          "summary",
          "why_it_matters",
          "source_count",
          "source_organization_count",
          "evidence_since",
          "registered_at",
          "falsifiers",
          "limitations",
          "sources",
          "version",
          "lifecycle",
          "superseded_by",
          "first_observed_at",
          "first_public_at",
          "last_reviewed_at",
          "last_changed_at",
          "next_review_at",
          "relations",
          "revision_ids",
          "review_required",
          "history_origin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "capability_delta",
              "cost_intelligence",
              "ecosystem_momentum",
              "platform_shift",
              "second_order_effect"
            ]
          },
          "status": {
            "enum": [
              "emerging",
              "strengthening",
              "stable",
              "weakening",
              "falsified"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string",
            "description": "Concise materiality statement: why this verified change is worth surfacing."
          },
          "our_read": {
            "type": ["string", "null"],
            "description": "Optional GrepSignal interpretation that adds meaning beyond the source summary. Omit or null when no additional interpretation is earned."
          },
          "second_order_effect": {
            "type": ["string", "null"],
            "description": "Optional downstream consequence. Omit or null rather than manufacturing a second-order effect."
          },
          "watch_next": {
            "type": ["string", "null"],
            "description": "Optional evidence that could update the judgment. Omit or null when there is no specific useful watch item."
          },
          "source_count": {
            "type": "integer",
            "minimum": 1
          },
          "source_organization_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "description": "Earliest evidence period represented by the Signal, at month precision. Do not treat this as an exact event timestamp."
          },
          "registered_at": {
            "type": "string",
            "format": "date",
            "description": "Date GrepSignal registered this Signal. This is not necessarily the event date, first observation time, or first public publication time."
          },
          "falsifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "publisher",
                "title",
                "url",
                "role"
              ],
              "properties": {
                "publisher": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "role": {
                  "type": "string"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retrieved_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "description": "Time GrepSignal actually retrieved or inspected this source when known. Null means the retrieval time was not recorded; it is never inferred from publication or journal timestamps."
                },
                "archive_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "Optional lawful public archive or durable source URL. Null means no archive is published by GrepSignal."
                },
                "lineage_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
                  "description": "Semantic evidence lineage. URLs that merely repeat the same underlying announcement, measurement, or incident should share one lineage ID."
                }
              },
              "additionalProperties": false
            }
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Revision number in the public accountability journal. Version 0 denotes the imported legacy snapshot, not a claim of complete pre-migration history."
          },
          "lifecycle": {
            "enum": [
              "active",
              "superseded",
              "retracted"
            ]
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_required": {
            "type": "boolean",
            "description": "True when linked changes or an inconclusive review require a fresh editorial review; it is not itself a reversal of the judgment."
          },
          "history_origin": {
            "enum": [
              "legacy_snapshot",
              "journal"
            ],
            "description": "Whether the record originated in the imported legacy snapshot or was registered in the append-only public journal."
          },
          "relations": {
            "type": "array"
          },
          "revision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Earliest observation time explicitly verified by GrepSignal; null means unknown, not that the event had not occurred."
          },
          "first_public_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Verified first-publication timestamp for this GrepSignal record; null means not verified."
          },
          "last_reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Most recent explicit review timestamp; null means no review is recorded in the public journal."
          },
          "last_changed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "next_review_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "review_due_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "thread_ids": {
            "type": "array",
            "description": "Derived IDs of Threads that currently link this Signal. This projection is computed from canonical Thread relations.",
            "items": {
              "type": "string"
            }
          },
          "thread_relations": {
            "type": "array",
            "description": "Derived typed reverse links from this Signal to current Thread relations.",
            "items": {
              "type": "object",
              "required": [
                "thread_id",
                "relationship"
              ],
              "properties": {
                "thread_id": {
                  "type": "string"
                },
                "relationship": {
                  "enum": [
                    "supporting",
                    "contradicting"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "signal_count",
          "summary",
          "updates",
          "version",
          "lifecycle",
          "superseded_by",
          "first_observed_at",
          "first_public_at",
          "last_reviewed_at",
          "last_changed_at",
          "next_review_at",
          "relations",
          "revision_ids",
          "review_required",
          "history_origin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "emerging",
              "strengthening",
              "stable",
              "weakening",
              "falsified"
            ]
          },
          "signal_count": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "evidence_since": {
            "type": "string",
            "description": "Earliest evidence period represented by this Thread; precision is source-dependent and should not be treated as the Thread creation time."
          },
          "created_at": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
          },
          "updates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "date",
                "assessment",
                "change",
                "signal_ids",
                "sources"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "assessment": {
                  "enum": [
                    "emerging",
                    "strengthening",
                    "stable",
                    "weakening",
                    "falsified"
                  ]
                },
                "effect_on_thesis": {
                  "type": ["string", "null"],
                  "enum": ["unchanged", "strengthened", "weakened", "revised", "falsified", null],
                  "description": "How this revision affects the tracked thesis. Legacy revisions may omit this field."
                },
                "change": {
                  "type": "string"
                },
                "signal_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "publisher",
                      "title",
                      "url",
                      "role"
                    ],
                    "properties": {
                      "publisher": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      },
                      "role": {
                        "type": "string"
                      },
                      "published_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "retrieved_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time",
                        "description": "Time GrepSignal actually retrieved or inspected this source when known; null means unknown."
                      },
                      "archive_url": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "uri",
                        "pattern": "^https://",
                        "description": "Optional lawful public archive or durable source URL."
                      },
                      "lineage_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
                        "description": "Semantic evidence lineage. URLs that merely repeat the same underlying announcement, measurement, or incident should share one lineage ID."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "pattern_scope": {
                  "enum": [
                    "cross_actor",
                    "same_actor",
                    "mixed",
                    "unclear"
                  ]
                },
                "event_independence": {
                  "enum": [
                    "independent_events",
                    "same_event_repeated",
                    "mixed",
                    "unclear"
                  ]
                },
                "mechanism_coherence": {
                  "enum": [
                    "strong",
                    "partial",
                    "weak",
                    "unclear"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "analysis": {
            "type": "object",
            "required": [
              "evidence_map",
              "boundaries",
              "view_tests"
            ],
            "properties": {
              "evidence_map": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "summary",
                    "signal_ids"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "signal_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "boundaries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "view_tests": {
                "type": "object",
                "required": [
                  "strengthen",
                  "weaken"
                ],
                "properties": {
                  "strengthen": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "weaken": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Revision number in the public accountability journal. Version 0 denotes the imported legacy snapshot, not complete pre-migration history."
          },
          "lifecycle": {
            "enum": [
              "active",
              "superseded",
              "retracted"
            ]
          },
          "superseded_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_required": {
            "type": "boolean",
            "description": "True when linked changes or an inconclusive review require a fresh editorial review."
          },
          "history_origin": {
            "enum": [
              "legacy_snapshot",
              "journal"
            ],
            "description": "Whether the record originated in the imported legacy snapshot or was registered in the append-only public journal."
          },
          "relations": {
            "type": "array"
          },
          "revision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Earliest observation time explicitly verified by GrepSignal; null means unknown."
          },
          "first_public_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Verified first-publication timestamp for this Thread record; null means not verified."
          },
          "last_reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Most recent explicit review timestamp; null means no review is recorded in the public journal."
          },
          "last_changed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "next_review_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "review_due_since": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "signal_ids": {
            "type": "array",
            "description": "Derived IDs of all Signals currently linked to this Thread, across supporting and contradicting relations.",
            "items": {
              "type": "string"
            }
          },
          "signal_relations": {
            "type": "object",
            "description": "Derived current typed Signal membership for this Thread.",
            "required": [
              "supporting",
              "contradicting"
            ],
            "properties": {
              "supporting": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contradicting": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "thread_id",
          "claim",
          "status",
          "created_at",
          "deadline",
          "success_criterion",
          "failure_criterion",
          "initial_probability",
          "insufficient_evidence_policy",
          "resolution_sources",
          "first_public_at",
          "lifecycle",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unregistered",
              "open",
              "resolved",
              "unresolved"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "superseded",
              "retracted"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "first_public_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "initial_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "insufficient_evidence_policy": {
            "const": "unresolved"
          },
          "success_criterion": {
            "type": "string",
            "minLength": 1
          },
          "failure_criterion": {
            "type": "string",
            "minLength": 1
          },
          "resolution_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "content_license": {
      "type": "object",
      "required": [
        "identifier",
        "url",
        "scope"
      ]
    },
    "accountability": {
      "type": "object",
      "required": [
        "baseline_ref",
        "initialized_at",
        "latest_sequence",
        "last_recorded_at"
      ]
    }
  },
  "additionalProperties": true,
  "description": "Current public intelligence projection derived from a pinned legacy snapshot plus accepted journal events. Derived Signal↔Thread links are included for agent retrieval. Registration, observation, source publication, retrieval, review, and public-publication times are distinct."
}

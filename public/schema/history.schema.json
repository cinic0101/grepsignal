{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinic0101.github.io/grepsignal/schema/history.schema.json",
  "title": "GrepSignal accepted event journal",
  "description": "Structural envelope. Registration/revision allowlists, immutable terms, exact versions and old-prefix invariants are enforced by accountability.mjs/check-history.mjs.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline_links_blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseline_ref": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "initialized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "initial_thread_review_due_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "record_type": {
            "enum": [
              "signal",
              "thread",
              "prediction"
            ]
          },
          "record_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "register",
              "revise",
              "review",
              "supersede",
              "retract",
              "resolve",
              "publication",
              "relate"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "proposed_by": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "publication",
                  "review"
                ]
              },
              "reference": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "accepted_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            },
            "required": [
              "actor",
              "scope",
              "reference",
              "accepted_at"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "url",
                "publisher",
                "title",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "record_type",
          "record_id",
          "expected_version",
          "kind",
          "recorded_at",
          "proposed_by",
          "acceptance",
          "note",
          "evidence",
          "payload"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "review"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": [
                        "unchanged",
                        "inconclusive"
                      ]
                    },
                    "counterevidence_checked": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "next_review_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    }
                  },
                  "required": [
                    "outcome",
                    "counterevidence_checked",
                    "next_review_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "publication"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "first_public_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "verification_url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  },
                  "required": [
                    "first_public_at",
                    "verification_url"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "retract"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "supersede"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "superseded_by": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
                    }
                  },
                  "required": [
                    "superseded_by"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "relate"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "target_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
                    },
                    "relationship": {
                      "enum": [
                        "supports",
                        "challenges",
                        "depends_on"
                      ]
                    },
                    "target_version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "target_id",
                    "relationship",
                    "target_version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "resolve"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": [
                        "true",
                        "false",
                        "unresolved"
                      ]
                    },
                    "supersedes_resolution": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "outcome"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "baseline_blob_sha",
    "baseline_links_blob_sha",
    "baseline_ref",
    "initialized_at",
    "initial_thread_review_due_at",
    "events"
  ],
  "additionalProperties": false
}

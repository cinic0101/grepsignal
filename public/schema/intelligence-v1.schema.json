{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinic0101.github.io/grepsignal/schema/intelligence-v1.schema.json",
  "title": "GrepSignal public intelligence envelope",
  "type": "object",
  "required": [
    "schema_version",
    "publication_status",
    "canonical_language",
    "generated_at",
    "stats",
    "signals",
    "threads",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publication_status": {
      "enum": [
        "preview_sample",
        "published"
      ]
    },
    "canonical_language": {
      "const": "en"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notice": {
      "type": "string"
    },
    "stats": {
      "type": "object",
      "required": [
        "material_signals",
        "active_threads",
        "open_predictions"
      ],
      "properties": {
        "material_signals": {
          "type": "integer",
          "minimum": 0
        },
        "active_threads": {
          "type": "integer",
          "minimum": 0
        },
        "open_predictions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "title",
          "summary",
          "why_it_matters",
          "second_order_effect",
          "watch_next",
          "source_count",
          "source_organization_count",
          "evidence_since",
          "registered_at",
          "falsifiers",
          "limitations",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "capability_delta",
              "cost_intelligence",
              "ecosystem_momentum",
              "platform_shift",
              "second_order_effect"
            ]
          },
          "status": {
            "enum": [
              "emerging",
              "strengthening",
              "stable",
              "weakening"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "second_order_effect": {
            "type": "string"
          },
          "watch_next": {
            "type": "string"
          },
          "source_count": {
            "type": "integer",
            "minimum": 1
          },
          "source_organization_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_since": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "registered_at": {
            "type": "string",
            "format": "date"
          },
          "falsifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "publisher",
                "title",
                "url",
                "role"
              ],
              "properties": {
                "publisher": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "role": {
                  "type": "string"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "signal_count",
          "summary",
          "updates"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "emerging",
              "strengthening",
              "stable",
              "weakening"
            ]
          },
          "signal_count": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "evidence_since": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_updated": {
            "type": "string"
          },
          "updates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "date",
                "assessment",
                "change",
                "signal_ids",
                "sources"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "assessment": {
                  "enum": [
                    "emerging",
                    "strengthening",
                    "stable",
                    "weakening"
                  ]
                },
                "change": {
                  "type": "string"
                },
                "signal_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "publisher",
                      "title",
                      "url",
                      "role"
                    ],
                    "properties": {
                      "publisher": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://"
                      },
                      "role": {
                        "type": "string"
                      },
                      "published_at": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "pattern_scope": {
                  "enum": [
                    "cross_actor",
                    "same_actor",
                    "mixed",
                    "unclear"
                  ]
                },
                "event_independence": {
                  "enum": [
                    "independent_events",
                    "same_event_repeated",
                    "mixed",
                    "unclear"
                  ]
                },
                "mechanism_coherence": {
                  "enum": [
                    "strong",
                    "partial",
                    "weak",
                    "unclear"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "analysis": {
            "type": "object",
            "required": [
              "evidence_map",
              "boundaries",
              "view_tests"
            ],
            "properties": {
              "evidence_map": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "summary",
                    "signal_ids"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "signal_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "boundaries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "view_tests": {
                "type": "object",
                "required": [
                  "strengthen",
                  "weaken"
                ],
                "properties": {
                  "strengthen": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "weaken": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "status"
        ]
      }
    }
  },
  "additionalProperties": true
}
